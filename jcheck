import json
import math
from pathlib import Path
from typing import Any, Dict, List, Optional
import pandas as pd


# =========================================================
# CONFIG
# =========================================================

RESULTS_ROOT = Path(r"C:\path\to\results")
GROUND_TRUTH_ROOT = Path(r"C:\path\to\ground_truth")

ROUTES_BY_FOLDER = {
    "A": "response.output",
    "B": "prediction.final",
    "C": "data.items",
}

# Try multiple thresholds
CONFIDENCE_THRESHOLDS = [0, 50, 60, 70, 80, 90, 95]

# If confidence is 0-1 instead of 0-100, set True
CONFIDENCE_IS_PROBABILITY = False

STRIP_STRINGS = True
CASE_INSENSITIVE_STRINGS = False

# Manual corrections to naive exact-match correct count by doc type.
# Applied at summary level for each threshold.
MANUAL_CORRECT_OFFSET_BY_FOLDER = {
    "A": 0,
    "B": 0,
    "C": 0,
    # Example:
    # "business_address": 5,
}

OUTPUT_DIR = Path("./performance_metrics_thresholds_output")
OUTPUT_DIR.mkdir(parents=True, exist_ok=True)


# =========================================================
# BASIC HELPERS
# =========================================================

def load_json(path: Path) -> Any:
    with open(path, "r", encoding="utf-8") as f:
        return json.load(f)


def normalize_value(x: Any) -> Any:
    if isinstance(x, str):
        if STRIP_STRINGS:
            x = x.strip()
        if CASE_INSENSITIVE_STRINGS:
            x = x.lower()
    return x


def get_by_route(obj: Any, route: str) -> Any:
    """
    Supports dotted routes:
      a.b.c
      items.0.name
    """
    cur = obj

    if route is None or route == "":
        return cur

    for part in route.split("."):
        if isinstance(cur, dict):
            if part not in cur:
                return None
            cur = cur[part]

        elif isinstance(cur, list):
            if not part.isdigit():
                return None
            idx = int(part)
            if idx < 0 or idx >= len(cur):
                return None
            cur = cur[idx]

        else:
            return None

    return cur


def list_relative_jsons(folder: Path) -> List[Path]:
    if not folder.exists():
        return []
    return sorted([p.relative_to(folder) for p in folder.rglob("*.json")])


def coerce_confidence(x: Any) -> Optional[float]:
    if x is None:
        return None

    try:
        val = float(x)
    except Exception:
        return None

    if math.isnan(val):
        return None

    if CONFIDENCE_IS_PROBABILITY:
        val *= 100.0

    return val


def find_all_confidences(obj: Any) -> List[float]:
    """
    Recursively find all keys named 'confidence' under a prediction node.
    """
    confidences = []

    if isinstance(obj, dict):
        for k, v in obj.items():
            if k == "confidence":
                c = coerce_confidence(v)
                if c is not None:
                    confidences.append(c)
            else:
                confidences.extend(find_all_confidences(v))

    elif isinstance(obj, list):
        for item in obj:
            confidences.extend(find_all_confidences(item))

    return confidences


def extract_node_confidence(obj: Any) -> Optional[float]:
    """
    For a prediction node containing 'value', find any confidence inside that node.
    If multiple confidence values exist, use max.
    """
    confidences = find_all_confidences(obj)
    if not confidences:
        return None
    return max(confidences)


def fbeta_score(
    accuracy: Optional[float],
    coverage: Optional[float],
    beta: float = 1.0,
) -> Optional[float]:
    """
    Harmonic mean of accuracy and coverage.
    beta=1: balanced.
    beta=2: coverage-weighted.
    """
    if accuracy is None or coverage is None:
        return None

    if accuracy == 0 and coverage == 0:
        return 0.0

    beta2 = beta ** 2
    denom = beta2 * accuracy + coverage

    if denom == 0:
        return 0.0

    return (1 + beta2) * accuracy * coverage / denom


# =========================================================
# FLATTENING
# =========================================================

def flatten_prediction_value_paths(
    obj: Any,
    parent_key: str = "",
) -> Dict[str, Dict[str, Any]]:
    """
    Recursively finds every dict containing key 'value'.

    Prediction output:
    {
        "address.city": {
            "value": "Dallas",
            "confidence": 91.0,
            "has_confidence": True
        },
        "middle_name": {
            "value": None,
            "confidence": None,
            "has_confidence": False
        }
    }

    Notes:
    - value can be None and still counts as a returned prediction.
    - confidence is only used to exclude explicitly low-confidence predictions.
    """
    items = {}

    if isinstance(obj, dict):
        if "value" in obj:
            clean_key = parent_key if parent_key else "value"
            raw_value = obj.get("value")
            confidence = extract_node_confidence(obj)

            items[clean_key] = {
                "value": normalize_value(raw_value),
                "confidence": confidence,
                "has_confidence": confidence is not None,
            }

        for k, v in obj.items():
            if k == "value":
                continue

            new_key = f"{parent_key}.{k}" if parent_key else k
            items.update(flatten_prediction_value_paths(v, new_key))

    elif isinstance(obj, list):
        for i, v in enumerate(obj):
            new_key = f"{parent_key}.{i}" if parent_key else str(i)
            items.update(flatten_prediction_value_paths(v, new_key))

    return items


def flatten_gt_value_paths(
    obj: Any,
    parent_key: str = "",
) -> Dict[str, Any]:
    """
    Recursively finds every dict containing key 'value' on GT side.

    GT output:
    {
        "address.city": "Dallas",
        "middle_name": None
    }
    """
    items = {}

    if isinstance(obj, dict):
        if "value" in obj:
            clean_key = parent_key if parent_key else "value"
            items[clean_key] = normalize_value(obj.get("value"))

        for k, v in obj.items():
            if k == "value":
                continue

            new_key = f"{parent_key}.{k}" if parent_key else k
            items.update(flatten_gt_value_paths(v, new_key))

    elif isinstance(obj, list):
        for i, v in enumerate(obj):
            new_key = f"{parent_key}.{i}" if parent_key else str(i)
            items.update(flatten_gt_value_paths(v, new_key))

    return items


# =========================================================
# STATUS / COVERAGE LOGIC
# =========================================================

def classify_prediction_status(
    pred_info: Optional[Dict[str, Any]],
    threshold: float,
) -> str:
    """
    Latest rule:

    missing_pred:
        prediction key/node does not exist
        => not covered

    explicit_low_conf:
        prediction exists, confidence exists, confidence < threshold
        => not covered

    covered_with_confidence:
        prediction exists, confidence exists, confidence >= threshold
        => covered

    covered_without_confidence:
        prediction exists, confidence missing/null
        => covered

    This applies whether prediction value is null or non-null.
    """
    if pred_info is None:
        return "missing_pred"

    confidence = pred_info.get("confidence")

    if confidence is not None and confidence < threshold:
        return "explicit_low_conf"

    if confidence is not None and confidence >= threshold:
        return "covered_with_confidence"

    return "covered_without_confidence"


def is_covered_status(status: str) -> bool:
    return status in {
        "covered_with_confidence",
        "covered_without_confidence",
    }


# =========================================================
# EVALUATE ONE FILE
# =========================================================

def evaluate_one_file(
    gt_flat: Dict[str, Any],
    pred_flat: Dict[str, Dict[str, Any]],
    threshold: float,
) -> Dict[str, Any]:
    """
    Leaf-level only.

    total:
        all leaf fields appearing in GT or prediction.

    covered:
        prediction exists and is not explicitly low confidence.

    correct:
        covered prediction value equals GT value.
        Null is compared as a real value.
    """
    all_fields = sorted(set(gt_flat.keys()) | set(pred_flat.keys()))

    total = len(all_fields)
    covered = 0
    correct = 0

    missing_pred = 0
    explicit_low_conf = 0
    covered_with_confidence = 0
    covered_without_confidence = 0

    null_gt_fields = 0
    null_pred_covered = 0
    null_pred_correct = 0
    prediction_only_fields = 0

    per_field = {}

    for field in all_fields:
        gt_present = field in gt_flat
        pred_present = field in pred_flat

        gt_val = gt_flat.get(field)
        pred_info = pred_flat.get(field)
        pred_val = pred_info.get("value") if pred_info is not None else None
        confidence = pred_info.get("confidence") if pred_info is not None else None

        if gt_present and gt_val is None:
            null_gt_fields += 1

        if pred_present and not gt_present:
            prediction_only_fields += 1

        status = classify_prediction_status(pred_info, threshold)
        is_covered = is_covered_status(status)

        match = None

        if is_covered:
            covered += 1
            match = pred_val == gt_val

            if match:
                correct += 1

            if pred_val is None:
                null_pred_covered += 1
                if match:
                    null_pred_correct += 1

            if status == "covered_with_confidence":
                covered_with_confidence += 1
            elif status == "covered_without_confidence":
                covered_without_confidence += 1

        else:
            if status == "missing_pred":
                missing_pred += 1
            elif status == "explicit_low_conf":
                explicit_low_conf += 1

        per_field[field] = {
            "gt_present": gt_present,
            "pred_present": pred_present,
            "gt_value": gt_val,
            "pred_value": pred_val,
            "confidence": confidence,
            "status": status,
            "covered": is_covered,
            "match": match,
        }

    coverage = covered / total if total else None
    accuracy = correct / covered if covered else None

    return {
        "total": total,
        "covered": covered,
        "correct": correct,
        "coverage": coverage,
        "accuracy": accuracy,
        "f1_balanced_score": fbeta_score(accuracy, coverage, beta=1.0),
        "f2_coverage_weighted_score": fbeta_score(accuracy, coverage, beta=2.0),

        "missing_pred": missing_pred,
        "explicit_low_conf": explicit_low_conf,
        "covered_with_confidence": covered_with_confidence,
        "covered_without_confidence": covered_without_confidence,

        "null_gt_fields": null_gt_fields,
        "null_pred_covered": null_pred_covered,
        "null_pred_correct": null_pred_correct,
        "prediction_only_fields": prediction_only_fields,

        "per_field": per_field,
    }


# =========================================================
# BUILD PER-FILE TABLE FOR ONE DOC TYPE + THRESHOLD
# =========================================================

def build_folder_per_file_table(
    folder_name: str,
    result_folder: Path,
    gt_folder: Path,
    route: str,
    threshold: float,
) -> pd.DataFrame:
    result_files = set(list_relative_jsons(result_folder))
    gt_files = set(list_relative_jsons(gt_folder))

    # Start from result files and evaluate only those with matching GT.
    common_files = sorted([p for p in result_files if p in gt_files])

    rows = []

    for rel_path in common_files:
        pred_path = result_folder / rel_path
        gt_path = gt_folder / rel_path

        row = {
            "doc_type": folder_name,
            "file": str(rel_path),
            "threshold": threshold,
            "status": "OK",
        }

        try:
            pred_json = load_json(pred_path)
            gt_json = load_json(gt_path)
        except Exception as e:
            row["status"] = f"read_error: {e}"
            rows.append(row)
            continue

        pred_subtree = get_by_route(pred_json, route)
        gt_subtree = get_by_route(gt_json, route)

        if pred_subtree is None:
            row["status"] = "missing_route_in_prediction"
            rows.append(row)
            continue

        if gt_subtree is None:
            row["status"] = "missing_route_in_gt"
            rows.append(row)
            continue

        pred_flat = flatten_prediction_value_paths(pred_subtree)
        gt_flat = flatten_gt_value_paths(gt_subtree)

        eval_result = evaluate_one_file(
            gt_flat=gt_flat,
            pred_flat=pred_flat,
            threshold=threshold,
        )

        metric_keys = [
            "total",
            "covered",
            "correct",
            "coverage",
            "accuracy",
            "f1_balanced_score",
            "f2_coverage_weighted_score",

            "missing_pred",
            "explicit_low_conf",
            "covered_with_confidence",
            "covered_without_confidence",

            "null_gt_fields",
            "null_pred_covered",
            "null_pred_correct",
            "prediction_only_fields",
        ]

        for k in metric_keys:
            row[k] = eval_result[k]

        # Detailed leaf-node columns
        for field, info in eval_result["per_field"].items():
            row[f"{field}_gt_present"] = info["gt_present"]
            row[f"{field}_pred_present"] = info["pred_present"]
            row[f"{field}_gt"] = info["gt_value"]
            row[f"{field}_pred"] = info["pred_value"]
            row[f"{field}_confidence"] = info["confidence"]
            row[f"{field}_status"] = info["status"]
            row[f"{field}_covered"] = info["covered"]
            row[f"{field}_match"] = info["match"]

        rows.append(row)

    # Diagnostic rows only
    for rel_path in sorted(result_files - gt_files):
        rows.append({
            "doc_type": folder_name,
            "file": str(rel_path),
            "threshold": threshold,
            "status": "result_file_without_matching_gt_ignored",
        })

    df = pd.DataFrame(rows)

    if df.empty:
        return df

    fixed_first = [
        "doc_type",
        "file",
        "threshold",
        "status",

        "total",
        "covered",
        "correct",
        "coverage",
        "accuracy",
        "f1_balanced_score",
        "f2_coverage_weighted_score",

        "missing_pred",
        "explicit_low_conf",
        "covered_with_confidence",
        "covered_without_confidence",

        "null_gt_fields",
        "null_pred_covered",
        "null_pred_correct",
        "prediction_only_fields",
    ]

    fixed_first = [c for c in fixed_first if c in df.columns]
    remaining = [c for c in df.columns if c not in fixed_first]

    return df[fixed_first + remaining].sort_values(["file"]).reset_index(drop=True)


# =========================================================
# SUMMARY TABLES
# =========================================================

def build_summary_from_file_table(
    df: pd.DataFrame,
    doc_type: str,
    threshold: float,
    manual_correct_offset_by_folder: Optional[Dict[str, int]] = None,
) -> Dict[str, Any]:

    ok_df = df[df["status"] == "OK"].copy() if "status" in df.columns else pd.DataFrame()

    if ok_df.empty:
        return {
            "doc_type": doc_type,
            "threshold": threshold,
            "files_compared": 0,

            "total": 0,
            "covered": 0,
            "correct_raw": 0,
            "correct_manual_offset": 0,
            "correct": 0,
            "coverage": None,
            "accuracy": None,
            "f1_balanced_score": None,
            "f2_coverage_weighted_score": None,

            "missing_pred": 0,
            "explicit_low_conf": 0,
            "covered_with_confidence": 0,
            "covered_without_confidence": 0,

            "null_gt_fields": 0,
            "null_pred_covered": 0,
            "null_pred_correct": 0,
            "prediction_only_fields": 0,
        }

    total = int(ok_df["total"].sum())
    covered = int(ok_df["covered"].sum())
    correct_raw = int(ok_df["correct"].sum())

    manual_offset = 0
    if manual_correct_offset_by_folder is not None:
        manual_offset = int(manual_correct_offset_by_folder.get(doc_type, 0))

    correct = min(correct_raw + manual_offset, covered)

    coverage = covered / total if total else None
    accuracy = correct / covered if covered else None

    return {
        "doc_type": doc_type,
        "threshold": threshold,
        "files_compared": int(len(ok_df)),

        "total": total,
        "covered": covered,
        "correct_raw": correct_raw,
        "correct_manual_offset": manual_offset,
        "correct": correct,
        "coverage": coverage,
        "accuracy": accuracy,
        "f1_balanced_score": fbeta_score(accuracy, coverage, beta=1.0),
        "f2_coverage_weighted_score": fbeta_score(accuracy, coverage, beta=2.0),

        "missing_pred": int(ok_df["missing_pred"].sum()),
        "explicit_low_conf": int(ok_df["explicit_low_conf"].sum()),
        "covered_with_confidence": int(ok_df["covered_with_confidence"].sum()),
        "covered_without_confidence": int(ok_df["covered_without_confidence"].sum()),

        "null_gt_fields": int(ok_df["null_gt_fields"].sum()),
        "null_pred_covered": int(ok_df["null_pred_covered"].sum()),
        "null_pred_correct": int(ok_df["null_pred_correct"].sum()),
        "prediction_only_fields": int(ok_df["prediction_only_fields"].sum()),
    }


def build_per_field_summary(
    file_df: pd.DataFrame,
    doc_type: str,
    threshold: float,
) -> pd.DataFrame:
    if file_df.empty or "status" not in file_df.columns:
        return pd.DataFrame()

    ok_df = file_df[file_df["status"] == "OK"].copy()

    if ok_df.empty:
        return pd.DataFrame()

    field_names = sorted({
        c[:-3] for c in ok_df.columns if c.endswith("_gt")
    })

    rows = []

    for field in field_names:
        covered_col = f"{field}_covered"
        match_col = f"{field}_match"
        status_col = f"{field}_status"
        conf_col = f"{field}_confidence"
        gt_present_col = f"{field}_gt_present"
        pred_present_col = f"{field}_pred_present"

        if covered_col not in ok_df.columns:
            continue

        present_mask = pd.Series(False, index=ok_df.index)

        if gt_present_col in ok_df.columns:
            present_mask = present_mask | ok_df[gt_present_col].fillna(False)

        if pred_present_col in ok_df.columns:
            present_mask = present_mask | ok_df[pred_present_col].fillna(False)

        total = int(present_mask.sum())

        covered = int(ok_df.loc[present_mask, covered_col].fillna(False).sum())

        correct = 0
        if match_col in ok_df.columns:
            covered_mask = present_mask & ok_df[covered_col].fillna(False)
            correct = int(ok_df.loc[covered_mask, match_col].fillna(False).sum())

        explicit_low_conf = 0
        missing_pred = 0
        covered_with_confidence = 0
        covered_without_confidence = 0

        if status_col in ok_df.columns:
            statuses = ok_df.loc[present_mask, status_col]
            explicit_low_conf = int((statuses == "explicit_low_conf").sum())
            missing_pred = int((statuses == "missing_pred").sum())
            covered_with_confidence = int((statuses == "covered_with_confidence").sum())
            covered_without_confidence = int((statuses == "covered_without_confidence").sum())

        avg_confidence = None
        if conf_col in ok_df.columns:
            avg_confidence = pd.to_numeric(ok_df.loc[present_mask, conf_col], errors="coerce").mean()

        coverage = covered / total if total else None
        accuracy = correct / covered if covered else None

        rows.append({
            "doc_type": doc_type,
            "threshold": threshold,
            "field": field,
            "total": total,
            "covered": covered,
            "correct": correct,
            "coverage": coverage,
            "accuracy": accuracy,
            "f1_balanced_score": fbeta_score(accuracy, coverage, beta=1.0),
            "f2_coverage_weighted_score": fbeta_score(accuracy, coverage, beta=2.0),

            "explicit_low_conf": explicit_low_conf,
            "missing_pred": missing_pred,
            "covered_with_confidence": covered_with_confidence,
            "covered_without_confidence": covered_without_confidence,
            "avg_confidence_when_present": avg_confidence,
        })

    out = pd.DataFrame(rows)

    if not out.empty:
        out = out.sort_values(
            ["threshold", "f1_balanced_score", "coverage", "accuracy"],
            ascending=[True, True, True, True],
            na_position="last",
        ).reset_index(drop=True)

    return out


def build_overall_summary(summary_df: pd.DataFrame) -> pd.DataFrame:
    overall_rows = []

    for threshold, g in summary_df.groupby("threshold", dropna=False):
        total = int(g["total"].sum())
        covered = int(g["covered"].sum())
        correct_raw = int(g["correct_raw"].sum())
        correct_manual_offset = int(g["correct_manual_offset"].sum())
        correct = int(g["correct"].sum())

        coverage = covered / total if total else None
        accuracy = correct / covered if covered else None

        overall_rows.append({
            "doc_type": "OVERALL",
            "threshold": threshold,
            "files_compared": int(g["files_compared"].sum()),

            "total": total,
            "covered": covered,
            "correct_raw": correct_raw,
            "correct_manual_offset": correct_manual_offset,
            "correct": correct,
            "coverage": coverage,
            "accuracy": accuracy,
            "f1_balanced_score": fbeta_score(accuracy, coverage, beta=1.0),
            "f2_coverage_weighted_score": fbeta_score(accuracy, coverage, beta=2.0),

            "missing_pred": int(g["missing_pred"].sum()),
            "explicit_low_conf": int(g["explicit_low_conf"].sum()),
            "covered_with_confidence": int(g["covered_with_confidence"].sum()),
            "covered_without_confidence": int(g["covered_without_confidence"].sum()),

            "null_gt_fields": int(g["null_gt_fields"].sum()),
            "null_pred_covered": int(g["null_pred_covered"].sum()),
            "null_pred_correct": int(g["null_pred_correct"].sum()),
            "prediction_only_fields": int(g["prediction_only_fields"].sum()),
        })

    return pd.DataFrame(overall_rows)


# =========================================================
# MAIN PERFORMANCE RUN
# =========================================================

def run_performance_evaluation_with_thresholds() -> None:
    all_summary_rows = []
    all_field_summaries = []
    all_file_tables = []

    for threshold in CONFIDENCE_THRESHOLDS:
        print(f"\n=== Threshold: {threshold} ===")

        for doc_type, route in ROUTES_BY_FOLDER.items():
            result_folder = RESULTS_ROOT / doc_type
            gt_folder = GROUND_TRUTH_ROOT / doc_type

            file_df = build_folder_per_file_table(
                folder_name=doc_type,
                result_folder=result_folder,
                gt_folder=gt_folder,
                route=route,
                threshold=threshold,
            )

            all_file_tables.append(file_df)

            file_out = OUTPUT_DIR / f"performance_{doc_type}_threshold_{threshold}_per_file.csv"
            file_df.to_csv(file_out, index=False)
            print(f"Saved {file_out}")

            summary_row = build_summary_from_file_table(
                df=file_df,
                doc_type=doc_type,
                threshold=threshold,
                manual_correct_offset_by_folder=MANUAL_CORRECT_OFFSET_BY_FOLDER,
            )
            all_summary_rows.append(summary_row)

            field_summary = build_per_field_summary(
                file_df=file_df,
                doc_type=doc_type,
                threshold=threshold,
            )

            if not field_summary.empty:
                all_field_summaries.append(field_summary)

                field_out = OUTPUT_DIR / f"performance_{doc_type}_threshold_{threshold}_per_field.csv"
                field_summary.to_csv(field_out, index=False)
                print(f"Saved {field_out}")

    # Doc-type summary across all thresholds
    summary_df = pd.DataFrame(all_summary_rows)

    # Overall rows per threshold
    overall_df = build_overall_summary(summary_df)

    final_summary_df = pd.concat([summary_df, overall_df], ignore_index=True)

    summary_out = OUTPUT_DIR / "performance_summary_all_thresholds.csv"
    final_summary_df.to_csv(summary_out, index=False)
    print(f"\nSaved {summary_out}")

    # Combined field summary
    if all_field_summaries:
        all_field_df = pd.concat(all_field_summaries, ignore_index=True)
        all_field_out = OUTPUT_DIR / "performance_all_fields_all_thresholds.csv"
        all_field_df.to_csv(all_field_out, index=False)
        print(f"Saved {all_field_out}")

    # Combined per-file table
    if all_file_tables:
        all_file_df = pd.concat(all_file_tables, ignore_index=True)
        all_file_out = OUTPUT_DIR / "performance_all_files_all_thresholds.csv"
        all_file_df.to_csv(all_file_out, index=False)
        print(f"Saved {all_file_out}")


if __name__ == "__main__":
    run_performance_evaluation_with_thresholds()
