# =========================================================
# BASIC HELPERS
# =========================================================

def load_json(path: Path) -> Any:
    with open(path, "r", encoding="utf-8") as f:
        return json.load(f)


def normalize_value(x: Any) -> Any:
    if isinstance(x, str):
        if STRIP_STRINGS:
            x = x.strip()
        if CASE_INSENSITIVE_STRINGS:
            x = x.lower()
    return x


def get_by_route(obj: Any, route: str) -> Any:
    """
    Supports dotted paths:
      a.b.c
      items.0.name
    """
    cur = obj

    if route is None or route == "":
        return cur

    for part in route.split("."):
        if isinstance(cur, dict):
            if part not in cur:
                return None
            cur = cur[part]

        elif isinstance(cur, list):
            if not part.isdigit():
                return None
            idx = int(part)
            if idx < 0 or idx >= len(cur):
                return None
            cur = cur[idx]

        else:
            return None

    return cur


def list_relative_jsons(folder: Path) -> List[Path]:
    if not folder.exists():
        return []
    return sorted([p.relative_to(folder) for p in folder.rglob("*.json")])


def coerce_confidence(x: Any) -> Optional[float]:
    if x is None:
        return None

    try:
        val = float(x)
    except Exception:
        return None

    if math.isnan(val):
        return None

    if CONFIDENCE_IS_PROBABILITY:
        val *= 100.0

    return val


def find_all_confidences(obj: Any) -> List[float]:
    """
    Recursively find all keys named 'confidence' under a node.
    """
    confidences = []

    if isinstance(obj, dict):
        for k, v in obj.items():
            if k == "confidence":
                c = coerce_confidence(v)
                if c is not None:
                    confidences.append(c)
            else:
                confidences.extend(find_all_confidences(v))

    elif isinstance(obj, list):
        for item in obj:
            confidences.extend(find_all_confidences(item))

    return confidences


def extract_node_confidence(obj: Any) -> Optional[float]:
    """
    For a prediction node containing 'value', find any confidence under that same node.
    If multiple confidence values exist, use max.
    """
    confidences = find_all_confidences(obj)
    if not confidences:
        return None
    return max(confidences)


def fbeta_score(
    accuracy: Optional[float],
    coverage: Optional[float],
    beta: float = 1.0,
) -> Optional[float]:
    """
    Harmonic mean of accuracy and coverage.
    beta=1 gives balanced score.
    beta=2 weights coverage more heavily.
    """
    if accuracy is None or coverage is None:
        return None

    if accuracy == 0 and coverage == 0:
        return 0.0

    beta2 = beta ** 2
    denom = beta2 * accuracy + coverage

    if denom == 0:
        return 0.0

    return (1 + beta2) * accuracy * coverage / denom


# =========================================================
# FLATTENING
# =========================================================

def flatten_prediction_value_paths(
    obj: Any,
    parent_key: str = "",
) -> Dict[str, Dict[str, Any]]:
    """
    Recursively finds every dict containing key 'value'.

    Output example:
    {
        "address.city": {
            "value": "Dallas",
            "confidence": 91.0,
            "has_confidence": True
        },
        "middle_name": {
            "value": None,
            "confidence": None,
            "has_confidence": False
        }
    }

    Important:
    - value can be None and still counts as a returned prediction.
    - confidence is only used to exclude explicitly low-confidence predictions.
    """
    items = {}

    if isinstance(obj, dict):
        if "value" in obj:
            clean_key = parent_key if parent_key else "value"
            raw_value = obj.get("value")
            confidence = extract_node_confidence(obj)

            items[clean_key] = {
                "value": normalize_value(raw_value),
                "confidence": confidence,
                "has_confidence": confidence is not None,
            }

        for k, v in obj.items():
            if k == "value":
                continue

            new_key = f"{parent_key}.{k}" if parent_key else k
            items.update(flatten_prediction_value_paths(v, new_key))

    elif isinstance(obj, list):
        for i, v in enumerate(obj):
            new_key = f"{parent_key}.{i}" if parent_key else str(i)
            items.update(flatten_prediction_value_paths(v, new_key))

    return items


def flatten_gt_value_paths(
    obj: Any,
    parent_key: str = "",
) -> Dict[str, Any]:
    """
    Recursively finds every dict containing key 'value' on GT side.

    Output example:
    {
        "address.city": "Dallas",
        "middle_name": None
    }
    """
    items = {}

    if isinstance(obj, dict):
        if "value" in obj:
            clean_key = parent_key if parent_key else "value"
            items[clean_key] = normalize_value(obj.get("value"))

        for k, v in obj.items():
            if k == "value":
                continue

            new_key = f"{parent_key}.{k}" if parent_key else k
            items.update(flatten_gt_value_paths(v, new_key))

    elif isinstance(obj, list):
        for i, v in enumerate(obj):
            new_key = f"{parent_key}.{i}" if parent_key else str(i)
            items.update(flatten_gt_value_paths(v, new_key))

    return items


# =========================================================
# STATUS / COVERAGE LOGIC
# =========================================================

def classify_prediction_status(
    pred_info: Optional[Dict[str, Any]],
    threshold: float,
) -> str:
    """
    Latest rule:

    - missing_pred:
        prediction key/node does not exist
        => not covered

    - explicit_low_conf:
        prediction exists, confidence exists, confidence < threshold
        => not covered

    - covered_with_confidence:
        prediction exists, confidence exists, confidence >= threshold
        => covered

    - covered_without_confidence:
        prediction exists, confidence missing/null
        => covered

    This applies whether prediction value is null or non-null.
    """
    if pred_info is None:
        return "missing_pred"

    confidence = pred_info.get("confidence")

    if confidence is not None and confidence < threshold:
        return "explicit_low_conf"

    if confidence is not None and confidence >= threshold:
        return "covered_with_confidence"

    return "covered_without_confidence"


def is_covered_status(status: str) -> bool:
    return status in {
        "covered_with_confidence",
        "covered_without_confidence",
    }


# =========================================================
# ROLLUP GROUPING
# =========================================================

def infer_default_group(field_name: str) -> str:
    """
    Examples:
      address.street -> address
      person.name.first -> person
      entity_name -> entity_name
    """
    return field_name.split(".")[0]


def assign_group_for_field(
    field_name: str,
    configured_groups: Optional[List[str]],
) -> str:
    """
    If configured_groups are provided, assign the most specific matching prefix.
    Otherwise use top-level prefix.
    """
    if configured_groups:
        matches = [
            g for g in configured_groups
            if field_name == g or field_name.startswith(g + ".")
        ]
        if matches:
            return max(matches, key=len)

    return infer_default_group(field_name)


def build_group_to_fields(
    field_names: List[str],
    configured_groups: Optional[List[str]],
) -> Dict[str, List[str]]:
    out = defaultdict(list)

    for field in field_names:
        group = assign_group_for_field(field, configured_groups)
        out[group].append(field)

    return dict(out)


# =========================================================
# EVALUATE ONE FILE
# =========================================================

def evaluate_one_file(
    gt_flat: Dict[str, Any],
    pred_flat: Dict[str, Dict[str, Any]],
    configured_groups: Optional[List[str]],
    threshold: float,
) -> Dict[str, Any]:
    """
    Field-level evaluation:
      denominator = all GT fields + prediction-only fields
      covered = prediction exists and is not explicitly low confidence
      accuracy = correct among covered

    This means:
      GT null vs pred null = correct if pred is covered
      GT non-null vs pred null = wrong if pred is covered
      GT null vs pred non-null = wrong if pred is covered
      pred confidence below threshold = not covered, excluded from accuracy
      pred missing = not covered
    """
    all_fields = sorted(set(gt_flat.keys()) | set(pred_flat.keys()))

    child_total = len(all_fields)
    child_covered = 0
    child_correct = 0

    missing_pred = 0
    explicit_low_conf = 0
    covered_with_confidence = 0
    covered_without_confidence = 0

    null_gt_fields = 0
    null_pred_covered = 0
    null_pred_correct = 0
    prediction_only_fields = 0

    per_field = {}

    for field in all_fields:
        gt_present = field in gt_flat
        pred_present = field in pred_flat

        gt_val = gt_flat.get(field)
        pred_info = pred_flat.get(field)
        pred_val = pred_info.get("value") if pred_info is not None else None
        confidence = pred_info.get("confidence") if pred_info is not None else None

        if gt_present and gt_val is None:
            null_gt_fields += 1

        if pred_present and not gt_present:
            prediction_only_fields += 1

        status = classify_prediction_status(pred_info, threshold)
        covered = is_covered_status(status)

        match = None

        if covered:
            child_covered += 1
            match = pred_val == gt_val

            if match:
                child_correct += 1

            if pred_val is None:
                null_pred_covered += 1
                if match:
                    null_pred_correct += 1

            if status == "covered_with_confidence":
                covered_with_confidence += 1
            elif status == "covered_without_confidence":
                covered_without_confidence += 1

        else:
            if status == "missing_pred":
                missing_pred += 1
            elif status == "explicit_low_conf":
                explicit_low_conf += 1

        per_field[field] = {
            "gt_present": gt_present,
            "pred_present": pred_present,
            "gt_value": gt_val,
            "pred_value": pred_val,
            "confidence": confidence,
            "status": status,
            "covered": covered,
            "match": match,
        }

    child_coverage_rate = child_covered / child_total if child_total else None
    child_accuracy = child_correct / child_covered if child_covered else None

    # -----------------------------
    # Rollup evaluation
    # -----------------------------
    group_to_fields = build_group_to_fields(all_fields, configured_groups)

    rollup_total = 0
    rollup_covered = 0
    rollup_correct = 0

    per_group = {}

    for group, fields in sorted(group_to_fields.items()):
        if not fields:
            continue

        rollup_total += 1

        group_all_covered = True
        group_all_correct = True

        for field in fields:
            gt_val = gt_flat.get(field)
            pred_info = pred_flat.get(field)
            pred_val = pred_info.get("value") if pred_info is not None else None

            status = classify_prediction_status(pred_info, threshold)

            if not is_covered_status(status):
                group_all_covered = False
                group_all_correct = False
                continue

            if pred_val != gt_val:
                group_all_correct = False

        if group_all_covered:
            rollup_covered += 1
            if group_all_correct:
                rollup_correct += 1

        per_group[group] = {
            "fields": fields,
            "covered": group_all_covered,
            "correct": group_all_correct,
            "num_fields": len(fields),
        }

    rollup_coverage_rate = rollup_covered / rollup_total if rollup_total else None
    rollup_accuracy = rollup_correct / rollup_covered if rollup_covered else None

    return {
        "child_total": child_total,
        "child_covered": child_covered,
        "child_correct": child_correct,
        "child_coverage_rate": child_coverage_rate,
        "child_accuracy": child_accuracy,
        "child_f1_balanced_score": fbeta_score(child_accuracy, child_coverage_rate, beta=1.0),
        "child_f2_coverage_weighted_score": fbeta_score(child_accuracy, child_coverage_rate, beta=2.0),

        "missing_pred": missing_pred,
        "explicit_low_conf": explicit_low_conf,
        "covered_with_confidence": covered_with_confidence,
        "covered_without_confidence": covered_without_confidence,

        "null_gt_fields": null_gt_fields,
        "null_pred_covered": null_pred_covered,
        "null_pred_correct": null_pred_correct,
        "prediction_only_fields": prediction_only_fields,

        "rollup_total": rollup_total,
        "rollup_covered": rollup_covered,
        "rollup_correct": rollup_correct,
        "rollup_coverage_rate": rollup_coverage_rate,
        "rollup_accuracy": rollup_accuracy,
        "rollup_f1_balanced_score": fbeta_score(rollup_accuracy, rollup_coverage_rate, beta=1.0),
        "rollup_f2_coverage_weighted_score": fbeta_score(rollup_accuracy, rollup_coverage_rate, beta=2.0),

        "per_field": per_field,
        "per_group": per_group,
    }


# =========================================================
# BUILD PER-FILE TABLE FOR ONE DOC TYPE
# =========================================================

def build_folder_per_file_table(
    folder_name: str,
    result_folder: Path,
    gt_folder: Path,
    route: str,
    configured_groups: Optional[List[str]],
    threshold: float,
) -> pd.DataFrame:
    result_files = set(list_relative_jsons(result_folder))
    gt_files = set(list_relative_jsons(gt_folder))

    # Start from result files and evaluate only if matching GT exists.
    # GT files absent from the result are not added as rows here.
    common_files = sorted([p for p in result_files if p in gt_files])

    rows = []

    for rel_path in common_files:
        pred_path = result_folder / rel_path
        gt_path = gt_folder / rel_path

        row = {
            "doc_type": folder_name,
            "file": str(rel_path),
            "status": "OK",
        }

        try:
            pred_json = load_json(pred_path)
            gt_json = load_json(gt_path)
        except Exception as e:
            row["status"] = f"read_error: {e}"
            rows.append(row)
            continue

        pred_subtree = get_by_route(pred_json, route)
        gt_subtree = get_by_route(gt_json, route)

        if pred_subtree is None:
            row["status"] = "missing_route_in_prediction"
            rows.append(row)
            continue

        if gt_subtree is None:
            row["status"] = "missing_route_in_gt"
            rows.append(row)
            continue

        pred_flat = flatten_prediction_value_paths(pred_subtree)
        gt_flat = flatten_gt_value_paths(gt_subtree)

        eval_result = evaluate_one_file(
            gt_flat=gt_flat,
            pred_flat=pred_flat,
            configured_groups=configured_groups,
            threshold=threshold,
        )

        metric_keys = [
            "child_total",
            "child_covered",
            "child_correct",
            "child_coverage_rate",
            "child_accuracy",
            "child_f1_balanced_score",
            "child_f2_coverage_weighted_score",

            "missing_pred",
            "explicit_low_conf",
            "covered_with_confidence",
            "covered_without_confidence",

            "null_gt_fields",
            "null_pred_covered",
            "null_pred_correct",
            "prediction_only_fields",

            "rollup_total",
            "rollup_covered",
            "rollup_correct",
            "rollup_coverage_rate",
            "rollup_accuracy",
            "rollup_f1_balanced_score",
            "rollup_f2_coverage_weighted_score",
        ]

        for k in metric_keys:
            row[k] = eval_result[k]

        # Add detailed field-level columns
        for field, info in eval_result["per_field"].items():
            row[f"{field}_gt_present"] = info["gt_present"]
            row[f"{field}_pred_present"] = info["pred_present"]
            row[f"{field}_gt"] = info["gt_value"]
            row[f"{field}_pred"] = info["pred_value"]
            row[f"{field}_confidence"] = info["confidence"]
            row[f"{field}_status"] = info["status"]
            row[f"{field}_covered"] = info["covered"]
            row[f"{field}_match"] = info["match"]

        rows.append(row)

    # Diagnostics only: result files without GT are ignored
    for rel_path in sorted(result_files - gt_files):
        rows.append({
            "doc_type": folder_name,
            "file": str(rel_path),
            "status": "result_file_without_matching_gt_ignored",
        })

    df = pd.DataFrame(rows)

    if df.empty:
        return df

    fixed_first = [
        "doc_type",
        "file",
        "status",

        "child_total",
        "child_covered",
        "child_correct",
        "child_coverage_rate",
        "child_accuracy",
        "child_f1_balanced_score",
        "child_f2_coverage_weighted_score",

        "missing_pred",
        "explicit_low_conf",
        "covered_with_confidence",
        "covered_without_confidence",

        "null_gt_fields",
        "null_pred_covered",
        "null_pred_correct",
        "prediction_only_fields",

        "rollup_total",
        "rollup_covered",
        "rollup_correct",
        "rollup_coverage_rate",
        "rollup_accuracy",
        "rollup_f1_balanced_score",
        "rollup_f2_coverage_weighted_score",
    ]

    fixed_first = [c for c in fixed_first if c in df.columns]
    remaining = [c for c in df.columns if c not in fixed_first]

    return df[fixed_first + remaining].sort_values(["file"]).reset_index(drop=True)


# =========================================================
# SUMMARY TABLES
# =========================================================

def build_summary_from_file_table(df: pd.DataFrame, doc_type: str) -> Dict[str, Any]:
    ok_df = df[df["status"] == "OK"].copy() if "status" in df.columns else pd.DataFrame()

    if ok_df.empty:
        return {
            "doc_type": doc_type,
            "files_compared": 0,

            "child_total": 0,
            "child_covered": 0,
            "child_correct": 0,
            "child_coverage_rate": None,
            "child_accuracy": None,
            "child_f1_balanced_score": None,
            "child_f2_coverage_weighted_score": None,

            "missing_pred": 0,
            "explicit_low_conf": 0,
            "covered_with_confidence": 0,
            "covered_without_confidence": 0,

            "null_gt_fields": 0,
            "null_pred_covered": 0,
            "null_pred_correct": 0,
            "prediction_only_fields": 0,

            "rollup_total": 0,
            "rollup_covered": 0,
            "rollup_correct": 0,
            "rollup_coverage_rate": None,
            "rollup_accuracy": None,
            "rollup_f1_balanced_score": None,
            "rollup_f2_coverage_weighted_score": None,
        }

    child_total = int(ok_df["child_total"].sum())
    child_covered = int(ok_df["child_covered"].sum())
    child_correct = int(ok_df["child_correct"].sum())

    rollup_total = int(ok_df["rollup_total"].sum())
    rollup_covered = int(ok_df["rollup_covered"].sum())
    rollup_correct = int(ok_df["rollup_correct"].sum())

    child_coverage = child_covered / child_total if child_total else None
    child_accuracy = child_correct / child_covered if child_covered else None

    rollup_coverage = rollup_covered / rollup_total if rollup_total else None
    rollup_accuracy = rollup_correct / rollup_covered if rollup_covered else None

    return {
        "doc_type": doc_type,
        "files_compared": int(len(ok_df)),

        "child_total": child_total,
        "child_covered": child_covered,
        "child_correct": child_correct,
        "child_coverage_rate": child_coverage,
        "child_accuracy": child_accuracy,
        "child_f1_balanced_score": fbeta_score(child_accuracy, child_coverage, beta=1.0),
        "child_f2_coverage_weighted_score": fbeta_score(child_accuracy, child_coverage, beta=2.0),

        "missing_pred": int(ok_df["missing_pred"].sum()),
        "explicit_low_conf": int(ok_df["explicit_low_conf"].sum()),
        "covered_with_confidence": int(ok_df["covered_with_confidence"].sum()),
        "covered_without_confidence": int(ok_df["covered_without_confidence"].sum()),

        "null_gt_fields": int(ok_df["null_gt_fields"].sum()),
        "null_pred_covered": int(ok_df["null_pred_covered"].sum()),
        "null_pred_correct": int(ok_df["null_pred_correct"].sum()),
        "prediction_only_fields": int(ok_df["prediction_only_fields"].sum()),

        "rollup_total": rollup_total,
        "rollup_covered": rollup_covered,
        "rollup_correct": rollup_correct,
        "rollup_coverage_rate": rollup_coverage,
        "rollup_accuracy": rollup_accuracy,
        "rollup_f1_balanced_score": fbeta_score(rollup_accuracy, rollup_coverage, beta=1.0),
        "rollup_f2_coverage_weighted_score": fbeta_score(rollup_accuracy, rollup_coverage, beta=2.0),
    }


def build_per_field_summary(file_df: pd.DataFrame, doc_type: str) -> pd.DataFrame:
    if file_df.empty or "status" not in file_df.columns:
        return pd.DataFrame()

    ok_df = file_df[file_df["status"] == "OK"].copy()

    if ok_df.empty:
        return pd.DataFrame()

    field_names = sorted({
        c[:-3] for c in ok_df.columns if c.endswith("_gt")
    })

    rows = []

    for field in field_names:
        covered_col = f"{field}_covered"
        match_col = f"{field}_match"
        status_col = f"{field}_status"
        conf_col = f"{field}_confidence"
        gt_present_col = f"{field}_gt_present"
        pred_present_col = f"{field}_pred_present"

        if covered_col not in ok_df.columns:
            continue

        # A row contributes to this field if field appears in GT or prediction.
        present_mask = pd.Series(False, index=ok_df.index)

        if gt_present_col in ok_df.columns:
            present_mask = present_mask | ok_df[gt_present_col].fillna(False)

        if pred_present_col in ok_df.columns:
            present_mask = present_mask | ok_df[pred_present_col].fillna(False)

        total = int(present_mask.sum())

        covered = int(ok_df.loc[present_mask, covered_col].fillna(False).sum())

        correct = 0
        if match_col in ok_df.columns:
            covered_mask = present_mask & ok_df[covered_col].fillna(False)
            correct = int(ok_df.loc[covered_mask, match_col].fillna(False).sum())

        explicit_low_conf = 0
        missing_pred = 0
        covered_with_confidence = 0
        covered_without_confidence = 0

        if status_col in ok_df.columns:
            statuses = ok_df.loc[present_mask, status_col]
            explicit_low_conf = int((statuses == "explicit_low_conf").sum())
            missing_pred = int((statuses == "missing_pred").sum())
            covered_with_confidence = int((statuses == "covered_with_confidence").sum())
            covered_without_confidence = int((statuses == "covered_without_confidence").sum())

        avg_confidence = None
        if conf_col in ok_df.columns:
            avg_confidence = pd.to_numeric(ok_df.loc[present_mask, conf_col], errors="coerce").mean()

        coverage = covered / total if total else None
        accuracy = correct / covered if covered else None

        rows.append({
            "doc_type": doc_type,
            "field": field,
            "total": total,
            "covered": covered,
            "correct": correct,
            "coverage_rate": coverage,
            "accuracy": accuracy,
            "f1_balanced_score": fbeta_score(accuracy, coverage, beta=1.0),
            "f2_coverage_weighted_score": fbeta_score(accuracy, coverage, beta=2.0),

            "explicit_low_conf": explicit_low_conf,
            "missing_pred": missing_pred,
            "covered_with_confidence": covered_with_confidence,
            "covered_without_confidence": covered_without_confidence,
            "avg_confidence_when_present": avg_confidence,
        })

    out = pd.DataFrame(rows)

    if not out.empty:
        out = out.sort_values(
            ["f1_balanced_score", "coverage_rate", "accuracy"],
            ascending=[True, True, True],
            na_position="last",
        ).reset_index(drop=True)

    return out


# =========================================================
# MAIN PERFORMANCE RUN
# =========================================================

def run_performance_evaluation() -> None:
    all_summary_rows = []
    all_field_summaries = []

    for doc_type, route in ROUTES_BY_FOLDER.items():
        result_folder = RESULTS_ROOT / doc_type
        gt_folder = GROUND_TRUTH_ROOT / doc_type
        configured_groups = ROLLUP_GROUPS_BY_FOLDER.get(doc_type)

        file_df = build_folder_per_file_table(
            folder_name=doc_type,
            result_folder=result_folder,
            gt_folder=gt_folder,
            route=route,
            configured_groups=configured_groups,
            threshold=CONFIDENCE_THRESHOLD,
        )

        file_out = OUTPUT_DIR / f"performance_{doc_type}_per_file.csv"
        file_df.to_csv(file_out, index=False)
        print(f"Saved {file_out}")

        summary_row = build_summary_from_file_table(file_df, doc_type)
        all_summary_rows.append(summary_row)

        field_summary = build_per_field_summary(file_df, doc_type)

        if not field_summary.empty:
            all_field_summaries.append(field_summary)
            field_out = OUTPUT_DIR / f"performance_{doc_type}_per_field.csv"
            field_summary.to_csv(field_out, index=False)
            print(f"Saved {field_out}")

    summary_df = pd.DataFrame(all_summary_rows)

    # Overall micro-average across doc types
    child_total = int(summary_df["child_total"].sum())
    child_covered = int(summary_df["child_covered"].sum())
    child_correct = int(summary_df["child_correct"].sum())

    rollup_total = int(summary_df["rollup_total"].sum())
    rollup_covered = int(summary_df["rollup_covered"].sum())
    rollup_correct = int(summary_df["rollup_correct"].sum())

    child_coverage = child_covered / child_total if child_total else None
    child_accuracy = child_correct / child_covered if child_covered else None

    rollup_coverage = rollup_covered / rollup_total if rollup_total else None
    rollup_accuracy = rollup_correct / rollup_covered if rollup_covered else None

    overall_row = {
        "doc_type": "OVERALL",
        "files_compared": int(summary_df["files_compared"].sum()),

        "child_total": child_total,
        "child_covered": child_covered,
        "child_correct": child_correct,
        "child_coverage_rate": child_coverage,
        "child_accuracy": child_accuracy,
        "child_f1_balanced_score": fbeta_score(child_accuracy, child_coverage, beta=1.0),
        "child_f2_coverage_weighted_score": fbeta_score(child_accuracy, child_coverage, beta=2.0),

        "missing_pred": int(summary_df["missing_pred"].sum()),
        "explicit_low_conf": int(summary_df["explicit_low_conf"].sum()),
        "covered_with_confidence": int(summary_df["covered_with_confidence"].sum()),
        "covered_without_confidence": int(summary_df["covered_without_confidence"].sum()),

        "null_gt_fields": int(summary_df["null_gt_fields"].sum()),
        "null_pred_covered": int(summary_df["null_pred_covered"].sum()),
        "null_pred_correct": int(summary_df["null_pred_correct"].sum()),
        "prediction_only_fields": int(summary_df["prediction_only_fields"].sum()),

        "rollup_total": rollup_total,
        "rollup_covered": rollup_covered,
        "rollup_correct": rollup_correct,
        "rollup_coverage_rate": rollup_coverage,
        "rollup_accuracy": rollup_accuracy,
        "rollup_f1_balanced_score": fbeta_score(rollup_accuracy, rollup_coverage, beta=1.0),
        "rollup_f2_coverage_weighted_score": fbeta_score(rollup_accuracy, rollup_coverage, beta=2.0),
    }

    summary_df = pd.concat([summary_df, pd.DataFrame([overall_row])], ignore_index=True)

    summary_out = OUTPUT_DIR / "performance_summary.csv"
    summary_df.to_csv(summary_out, index=False)
    print(f"Saved {summary_out}")

    if all_field_summaries:
        all_field_df = pd.concat(all_field_summaries, ignore_index=True)

        all_field_out = OUTPUT_DIR / "performance_all_fields.csv"
        all_field_df.to_csv(all_field_out, index=False)
        print(f"Saved {all_field_out}")


if __name__ == "__main__":
    run_performance_evaluation()
