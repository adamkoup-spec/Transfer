# =========================================================
# BASIC HELPERS
# =========================================================

def load_json(path: Path) -> Any:
    with open(path, "r", encoding="utf-8") as f:
        return json.load(f)


def normalize_value(x: Any) -> Any:
    if isinstance(x, str):
        if STRIP_STRINGS:
            x = x.strip()
        if CASE_INSENSITIVE_STRINGS:
            x = x.lower()
    return x


def canonicalize_for_entropy(x: Any) -> Any:
    """
    Converts values into hashable / comparable forms.
    Keeps None as None.
    Dicts/lists are converted to sorted JSON strings.
    """
    if isinstance(x, (dict, list)):
        return json.dumps(x, sort_keys=True, ensure_ascii=False)
    return x


def get_by_route(obj: Any, route: str) -> Any:
    """
    Supports dotted routes:
      a.b.c
      items.0.name
    """
    cur = obj

    if route is None or route == "":
        return cur

    for part in route.split("."):
        if isinstance(cur, dict):
            if part not in cur:
                return None
            cur = cur[part]

        elif isinstance(cur, list):
            if not part.isdigit():
                return None
            idx = int(part)
            if idx < 0 or idx >= len(cur):
                return None
            cur = cur[idx]

        else:
            return None

    return cur


def list_relative_jsons(folder: Path) -> List[Path]:
    if not folder.exists():
        return []
    return sorted([p.relative_to(folder) for p in folder.rglob("*.json")])


def coerce_confidence(x: Any) -> Optional[float]:
    if x is None:
        return None

    try:
        val = float(x)
    except Exception:
        return None

    if math.isnan(val):
        return None

    if CONFIDENCE_IS_PROBABILITY:
        val *= 100.0

    return val


def find_all_confidences(obj: Any) -> List[float]:
    """
    Recursively finds all keys named 'confidence' under a node.
    """
    confidences = []

    if isinstance(obj, dict):
        for k, v in obj.items():
            if k == "confidence":
                c = coerce_confidence(v)
                if c is not None:
                    confidences.append(c)
            else:
                confidences.extend(find_all_confidences(v))

    elif isinstance(obj, list):
        for item in obj:
            confidences.extend(find_all_confidences(item))

    return confidences


def extract_node_confidence(obj: Any) -> Optional[float]:
    """
    For a prediction node containing 'value', find any confidence inside that node.
    If multiple confidence values exist, use max.
    """
    confidences = find_all_confidences(obj)
    if not confidences:
        return None
    return max(confidences)


def fbeta_score(
    accuracy: Optional[float],
    coverage: Optional[float],
    beta: float = 1.0,
) -> Optional[float]:
    if accuracy is None or coverage is None:
        return None

    if accuracy == 0 and coverage == 0:
        return 0.0

    beta2 = beta ** 2
    denom = beta2 * accuracy + coverage

    if denom == 0:
        return 0.0

    return (1 + beta2) * accuracy * coverage / denom


# =========================================================
# FLATTENING
# =========================================================

def flatten_prediction_value_paths(
    obj: Any,
    parent_key: str = "",
) -> Dict[str, Dict[str, Any]]:
    """
    Recursively finds every dict containing key 'value'.

    Prediction output:
    {
        "address.city": {
            "value": "Dallas",
            "confidence": 91.0,
            "has_confidence": True
        },
        "middle_name": {
            "value": None,
            "confidence": None,
            "has_confidence": False
        }
    }

    Null is a real prediction value if the prediction node exists.
    """
    items = {}

    if isinstance(obj, dict):
        if "value" in obj:
            clean_key = parent_key if parent_key else "value"
            raw_value = obj.get("value")
            confidence = extract_node_confidence(obj)

            items[clean_key] = {
                "value": normalize_value(raw_value),
                "confidence": confidence,
                "has_confidence": confidence is not None,
            }

        for k, v in obj.items():
            if k == "value":
                continue

            new_key = f"{parent_key}.{k}" if parent_key else k
            items.update(flatten_prediction_value_paths(v, new_key))

    elif isinstance(obj, list):
        for i, v in enumerate(obj):
            new_key = f"{parent_key}.{i}" if parent_key else str(i)
            items.update(flatten_prediction_value_paths(v, new_key))

    return items


def flatten_gt_value_paths(
    obj: Any,
    parent_key: str = "",
) -> Dict[str, Any]:
    """
    Recursively finds every dict containing key 'value' on GT side.

    GT output:
    {
        "address.city": "Dallas",
        "middle_name": None
    }
    """
    items = {}

    if isinstance(obj, dict):
        if "value" in obj:
            clean_key = parent_key if parent_key else "value"
            items[clean_key] = normalize_value(obj.get("value"))

        for k, v in obj.items():
            if k == "value":
                continue

            new_key = f"{parent_key}.{k}" if parent_key else k
            items.update(flatten_gt_value_paths(v, new_key))

    elif isinstance(obj, list):
        for i, v in enumerate(obj):
            new_key = f"{parent_key}.{i}" if parent_key else str(i)
            items.update(flatten_gt_value_paths(v, new_key))

    return items


# =========================================================
# STATUS / COVERAGE LOGIC
# =========================================================

def classify_prediction_status(
    pred_info: Optional[Dict[str, Any]],
    threshold: float,
) -> str:
    """
    Latest rule:

    missing_pred:
        prediction key/node does not exist
        => not covered

    explicit_low_conf:
        prediction exists, confidence exists, confidence < threshold
        => not covered

    covered_with_confidence:
        prediction exists, confidence exists, confidence >= threshold
        => covered

    covered_without_confidence:
        prediction exists, confidence missing/null
        => covered

    This applies whether prediction value is null or non-null.
    """
    if pred_info is None:
        return "missing_pred"

    confidence = pred_info.get("confidence")

    if confidence is not None and confidence < threshold:
        return "explicit_low_conf"

    if confidence is not None and confidence >= threshold:
        return "covered_with_confidence"

    return "covered_without_confidence"


def is_covered_status(status: str) -> bool:
    return status in {
        "covered_with_confidence",
        "covered_without_confidence",
    }


# =========================================================
# ENTROPY / STABILITY HELPERS
# =========================================================

def entropy_of_values(values: List[Any]) -> Optional[float]:
    """
    Shannon entropy in bits.
    """
    if not values:
        return None

    values = [canonicalize_for_entropy(v) for v in values]

    counts = Counter(values)
    total = sum(counts.values())

    h = 0.0
    for c in counts.values():
        p = c / total
        h -= p * math.log2(p)

    return h


def normalized_entropy(values: List[Any]) -> Optional[float]:
    """
    Entropy normalized by log2(n), where n is number of retained runs.
    0 = perfectly stable.
    1 = maximally unstable among retained values.
    """
    if not values:
        return None

    if len(values) <= 1:
        return 0.0

    h = entropy_of_values(values)
    hmax = math.log2(len(values))

    if h is None or hmax == 0:
        return None

    return h / hmax


def majority_agreement(values: List[Any]) -> Optional[float]:
    """
    Most common value count / retained value count.
    """
    if not values:
        return None

    values = [canonicalize_for_entropy(v) for v in values]

    counts = Counter(values)
    return counts.most_common(1)[0][1] / len(values)


def majority_value(values: List[Any]) -> Any:
    if not values:
        return None

    canonical_values = [canonicalize_for_entropy(v) for v in values]
    counts = Counter(canonical_values)
    return counts.most_common(1)[0][0]


# =========================================================
# PER-RUN METRICS
# =========================================================

def evaluate_one_run_file(
    gt_flat: Dict[str, Any],
    pred_flat: Dict[str, Dict[str, Any]],
    threshold: float,
) -> Dict[str, Any]:
    """
    Leaf-level file metrics under latest rule.
    """
    all_fields = sorted(set(gt_flat.keys()) | set(pred_flat.keys()))

    total = len(all_fields)
    covered = 0
    correct = 0

    missing_pred = 0
    explicit_low_conf = 0
    covered_with_confidence = 0
    covered_without_confidence = 0

    null_gt_fields = 0
    null_pred_covered = 0
    null_pred_correct = 0
    prediction_only_fields = 0

    for field in all_fields:
        gt_present = field in gt_flat
        pred_present = field in pred_flat

        gt_val = gt_flat.get(field)
        pred_info = pred_flat.get(field)
        pred_val = pred_info.get("value") if pred_info is not None else None

        if gt_present and gt_val is None:
            null_gt_fields += 1

        if pred_present and not gt_present:
            prediction_only_fields += 1

        status = classify_prediction_status(pred_info, threshold)

        if is_covered_status(status):
            covered += 1

            if pred_val == gt_val:
                correct += 1

            if pred_val is None:
                null_pred_covered += 1
                if pred_val == gt_val:
                    null_pred_correct += 1

            if status == "covered_with_confidence":
                covered_with_confidence += 1
            elif status == "covered_without_confidence":
                covered_without_confidence += 1

        else:
            if status == "missing_pred":
                missing_pred += 1
            elif status == "explicit_low_conf":
                explicit_low_conf += 1

    coverage = covered / total if total else None
    accuracy = correct / covered if covered else None

    return {
        "total": total,
        "covered": covered,
        "correct": correct,
        "coverage": coverage,
        "accuracy": accuracy,
        "f1_balanced_score": fbeta_score(accuracy, coverage, beta=1.0),
        "f2_coverage_weighted_score": fbeta_score(accuracy, coverage, beta=2.0),

        "missing_pred": missing_pred,
        "explicit_low_conf": explicit_low_conf,
        "covered_with_confidence": covered_with_confidence,
        "covered_without_confidence": covered_without_confidence,

        "null_gt_fields": null_gt_fields,
        "null_pred_covered": null_pred_covered,
        "null_pred_correct": null_pred_correct,
        "prediction_only_fields": prediction_only_fields,
    }


def compute_run_metrics_for_doc_type(
    run_root: Path,
    gt_root: Path,
    doc_type: str,
    route: str,
    threshold: float,
) -> Dict[str, Any]:
    """
    Computes one row of metrics for one run + one doc type + one threshold.
    """
    result_folder = run_root / doc_type
    gt_folder = gt_root / doc_type

    result_files = set(list_relative_jsons(result_folder))
    gt_files = set(list_relative_jsons(gt_folder))

    # Start from result files, evaluate only those with matching GT.
    common_files = sorted([p for p in result_files if p in gt_files])

    total = 0
    covered = 0
    correct = 0

    missing_pred = 0
    explicit_low_conf = 0
    covered_with_confidence = 0
    covered_without_confidence = 0

    null_gt_fields = 0
    null_pred_covered = 0
    null_pred_correct = 0
    prediction_only_fields = 0

    files_compared = 0
    route_failures = 0
    unreadable_files = 0
    result_file_without_matching_gt_ignored = len(result_files - gt_files)

    for rel_path in common_files:
        pred_path = result_folder / rel_path
        gt_path = gt_folder / rel_path

        try:
            pred_json = load_json(pred_path)
            gt_json = load_json(gt_path)
        except Exception:
            unreadable_files += 1
            continue

        pred_subtree = get_by_route(pred_json, route)
        gt_subtree = get_by_route(gt_json, route)

        if pred_subtree is None or gt_subtree is None:
            route_failures += 1
            continue

        pred_flat = flatten_prediction_value_paths(pred_subtree)
        gt_flat = flatten_gt_value_paths(gt_subtree)

        file_eval = evaluate_one_run_file(
            gt_flat=gt_flat,
            pred_flat=pred_flat,
            threshold=threshold,
        )

        files_compared += 1

        total += file_eval["total"]
        covered += file_eval["covered"]
        correct += file_eval["correct"]

        missing_pred += file_eval["missing_pred"]
        explicit_low_conf += file_eval["explicit_low_conf"]
        covered_with_confidence += file_eval["covered_with_confidence"]
        covered_without_confidence += file_eval["covered_without_confidence"]

        null_gt_fields += file_eval["null_gt_fields"]
        null_pred_covered += file_eval["null_pred_covered"]
        null_pred_correct += file_eval["null_pred_correct"]
        prediction_only_fields += file_eval["prediction_only_fields"]

    coverage = covered / total if total else None
    accuracy = correct / covered if covered else None

    return {
        "run_name": run_root.name,
        "doc_type": doc_type,
        "threshold": threshold,
        "files_compared": files_compared,
        "result_file_without_matching_gt_ignored": result_file_without_matching_gt_ignored,
        "route_failures": route_failures,
        "unreadable_files": unreadable_files,

        "total": total,
        "covered": covered,
        "correct": correct,
        "coverage": coverage,
        "accuracy": accuracy,
        "f1_balanced_score": fbeta_score(accuracy, coverage, beta=1.0),
        "f2_coverage_weighted_score": fbeta_score(accuracy, coverage, beta=2.0),

        "missing_pred": missing_pred,
        "explicit_low_conf": explicit_low_conf,
        "covered_with_confidence": covered_with_confidence,
        "covered_without_confidence": covered_without_confidence,

        "null_gt_fields": null_gt_fields,
        "null_pred_covered": null_pred_covered,
        "null_pred_correct": null_pred_correct,
        "prediction_only_fields": prediction_only_fields,
    }


# =========================================================
# FIELD STABILITY ACROSS RUNS
# =========================================================

def compute_field_stability_for_doc_type(
    run_roots: List[Path],
    gt_root: Path,
    doc_type: str,
    route: str,
    threshold: float,
) -> pd.DataFrame:
    """
    One row per doc_type + file + field + threshold.

    Stability is measured over covered predictions only.
    Explicit low-confidence and missing predictions are not retained.
    Null is retained as a value if the prediction node exists and is covered.
    """
    gt_folder = gt_root / doc_type

    # Union of GT files and result files across runs
    file_union = set(list_relative_jsons(gt_folder))
    for run_root in run_roots:
        file_union |= set(list_relative_jsons(run_root / doc_type))

    rows = []

    run_names = [r.name for r in run_roots]

    for rel_path in sorted(file_union):
        # GT
        gt_path = gt_folder / rel_path
        if gt_path.exists():
            try:
                gt_json = load_json(gt_path)
                gt_subtree = get_by_route(gt_json, route)
                gt_flat = flatten_gt_value_paths(gt_subtree) if gt_subtree is not None else {}
            except Exception:
                gt_flat = {}
        else:
            gt_flat = {}

        run_field_maps = []
        all_fields = set(gt_flat.keys())

        for run_root in run_roots:
            pred_path = run_root / doc_type / rel_path

            if pred_path.exists():
                try:
                    pred_json = load_json(pred_path)
                    pred_subtree = get_by_route(pred_json, route)
                    pred_flat = flatten_prediction_value_paths(pred_subtree) if pred_subtree is not None else {}
                except Exception:
                    pred_flat = {}
            else:
                pred_flat = {}

            run_field_maps.append((run_root.name, pred_flat))
            all_fields |= set(pred_flat.keys())

        for field in sorted(all_fields):
            gt_present = field in gt_flat
            gt_val = gt_flat.get(field)

            retained_values = []
            retained_matches = []

            run_statuses = {}
            run_values = {}
            run_confidences = {}
            run_covered = {}

            for run_name, pred_flat in run_field_maps:
                pred_info = pred_flat.get(field)
                status = classify_prediction_status(pred_info, threshold)

                pred_val = pred_info.get("value") if pred_info is not None else None
                pred_conf = pred_info.get("confidence") if pred_info is not None else None

                covered = is_covered_status(status)

                run_statuses[run_name] = status
                run_values[run_name] = pred_val
                run_confidences[run_name] = pred_conf
                run_covered[run_name] = covered

                if covered:
                    retained_values.append(pred_val)
                    retained_matches.append(pred_val == gt_val)

            n_runs = len(run_roots)
            n_retained = len(retained_values)

            ent = entropy_of_values(retained_values)
            nent = normalized_entropy(retained_values)
            maj_agree = majority_agreement(retained_values)
            maj_value = majority_value(retained_values)

            majority_correct = None
            if n_retained > 0:
                majority_correct = (maj_value == gt_val)

            retained_correct_rate = (
                sum(retained_matches) / n_retained
                if n_retained else None
            )

            row = {
                "doc_type": doc_type,
                "file": str(rel_path),
                "field": field,
                "threshold": threshold,

                "gt_present": gt_present,
                "gt_value": gt_val,

                "n_runs": n_runs,
                "n_retained_runs": n_retained,
                "retained_coverage": n_retained / n_runs if n_runs else None,

                "majority_value": maj_value,
                "majority_agreement": maj_agree,
                "entropy": ent,
                "normalized_entropy": nent,
                "fully_stable": (maj_agree == 1.0) if maj_agree is not None else None,

                "majority_correct": majority_correct,
                "retained_correct_rate": retained_correct_rate,
            }

            for run_name in run_names:
                row[f"{run_name}_status"] = run_statuses.get(run_name)
                row[f"{run_name}_covered"] = run_covered.get(run_name)
                row[f"{run_name}_value"] = run_values.get(run_name)
                row[f"{run_name}_confidence"] = run_confidences.get(run_name)

            rows.append(row)

    return pd.DataFrame(rows)


# =========================================================
# METRIC STABILITY ACROSS RUNS
# =========================================================

def compute_metric_stability_across_runs(
    per_run_metric_df: pd.DataFrame,
    metric_cols: List[str],
) -> pd.DataFrame:
    """
    Computes run-to-run stability of metrics for each doc type and threshold.
    """
    rows = []

    for (doc_type, threshold), grp in per_run_metric_df.groupby(["doc_type", "threshold"], dropna=False):
        row = {
            "doc_type": doc_type,
            "threshold": threshold,
            "n_runs": len(grp),
        }

        for metric in metric_cols:
            vals = pd.to_numeric(grp[metric], errors="coerce").dropna()

            row[f"{metric}_mean"] = vals.mean() if len(vals) else None
            row[f"{metric}_std"] = vals.std(ddof=0) if len(vals) else None
            row[f"{metric}_min"] = vals.min() if len(vals) else None
            row[f"{metric}_max"] = vals.max() if len(vals) else None
            row[f"{metric}_range"] = (vals.max() - vals.min()) if len(vals) else None

        rows.append(row)

    return pd.DataFrame(rows)


# =========================================================
# OVERALL SUMMARIES
# =========================================================

def build_overall_metric_per_run(per_run_metric_df: pd.DataFrame) -> pd.DataFrame:
    """
    Micro-averaged overall metrics by run and threshold across doc types.
    """
    rows = []

    for (run_name, threshold), grp in per_run_metric_df.groupby(["run_name", "threshold"], dropna=False):
        total = int(grp["total"].sum())
        covered = int(grp["covered"].sum())
        correct = int(grp["correct"].sum())

        coverage = covered / total if total else None
        accuracy = correct / covered if covered else None

        rows.append({
            "run_name": run_name,
            "doc_type": "OVERALL",
            "threshold": threshold,
            "files_compared": int(grp["files_compared"].sum()),

            "total": total,
            "covered": covered,
            "correct": correct,
            "coverage": coverage,
            "accuracy": accuracy,
            "f1_balanced_score": fbeta_score(accuracy, coverage, beta=1.0),
            "f2_coverage_weighted_score": fbeta_score(accuracy, coverage, beta=2.0),

            "missing_pred": int(grp["missing_pred"].sum()),
            "explicit_low_conf": int(grp["explicit_low_conf"].sum()),
            "covered_with_confidence": int(grp["covered_with_confidence"].sum()),
            "covered_without_confidence": int(grp["covered_without_confidence"].sum()),

            "null_gt_fields": int(grp["null_gt_fields"].sum()),
            "null_pred_covered": int(grp["null_pred_covered"].sum()),
            "null_pred_correct": int(grp["null_pred_correct"].sum()),
            "prediction_only_fields": int(grp["prediction_only_fields"].sum()),
        })

    return pd.DataFrame(rows)


def build_overall_field_stability(field_df: pd.DataFrame) -> pd.DataFrame:
    """
    Overall field-stability summary across doc types.
    """
    rows = []

    for threshold, grp in field_df.groupby("threshold", dropna=False):
        rows.append({
            "threshold": threshold,
            "n_field_file_pairs": len(grp),

            "mean_retained_coverage": pd.to_numeric(grp["retained_coverage"], errors="coerce").mean(),
            "mean_majority_agreement": pd.to_numeric(grp["majority_agreement"], errors="coerce").mean(),
            "mean_entropy": pd.to_numeric(grp["entropy"], errors="coerce").mean(),
            "mean_normalized_entropy": pd.to_numeric(grp["normalized_entropy"], errors="coerce").mean(),

            "fully_stable_rate": grp["fully_stable"].dropna().mean() if "fully_stable" in grp else None,
            "majority_correct_rate": grp["majority_correct"].dropna().mean() if "majority_correct" in grp else None,
            "mean_retained_correct_rate": pd.to_numeric(grp["retained_correct_rate"], errors="coerce").mean(),
        })

    return pd.DataFrame(rows)


def build_doc_type_field_stability_summary(field_df: pd.DataFrame) -> pd.DataFrame:
    """
    Field-stability summary per doc type and threshold.
    """
    rows = []

    for (doc_type, threshold), grp in field_df.groupby(["doc_type", "threshold"], dropna=False):
        rows.append({
            "doc_type": doc_type,
            "threshold": threshold,
            "n_field_file_pairs": len(grp),

            "mean_retained_coverage": pd.to_numeric(grp["retained_coverage"], errors="coerce").mean(),
            "mean_majority_agreement": pd.to_numeric(grp["majority_agreement"], errors="coerce").mean(),
            "mean_entropy": pd.to_numeric(grp["entropy"], errors="coerce").mean(),
            "mean_normalized_entropy": pd.to_numeric(grp["normalized_entropy"], errors="coerce").mean(),

            "fully_stable_rate": grp["fully_stable"].dropna().mean() if "fully_stable" in grp else None,
            "majority_correct_rate": grp["majority_correct"].dropna().mean() if "majority_correct" in grp else None,
            "mean_retained_correct_rate": pd.to_numeric(grp["retained_correct_rate"], errors="coerce").mean(),
        })

    return pd.DataFrame(rows)


