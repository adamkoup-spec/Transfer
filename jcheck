# MAIN
# =========================================================

def run_stability_analysis() -> None:
    per_run_metric_rows = []
    field_stability_frames = []

    for threshold in CONFIDENCE_THRESHOLDS:
        print(f"\n=== Threshold: {threshold} ===")

        for doc_type, route in ROUTES_BY_FOLDER.items():
            print(f"Doc type: {doc_type}")

            # Per-run metrics
            for run_root in RUN_ROOTS:
                row = compute_run_metrics_for_doc_type(
                    run_root=run_root,
                    gt_root=GROUND_TRUTH_ROOT,
                    doc_type=doc_type,
                    route=route,
                    threshold=threshold,
                )
                per_run_metric_rows.append(row)

            # Field stability across runs
            field_df = compute_field_stability_for_doc_type(
                run_roots=RUN_ROOTS,
                gt_root=GROUND_TRUTH_ROOT,
                doc_type=doc_type,
                route=route,
                threshold=threshold,
            )
            field_stability_frames.append(field_df)

    per_run_metric_df = pd.DataFrame(per_run_metric_rows)
    field_stability_df = (
        pd.concat(field_stability_frames, ignore_index=True)
        if field_stability_frames
        else pd.DataFrame()
    )

    # Overall per-run metrics across doc types
    overall_per_run_metric_df = build_overall_metric_per_run(per_run_metric_df)

    per_run_with_overall_df = pd.concat(
        [per_run_metric_df, overall_per_run_metric_df],
        ignore_index=True,
    )

    # Metric stability by doc type and threshold
    metric_cols = [
        "coverage",
        "accuracy",
        "f1_balanced_score",
        "f2_coverage_weighted_score",
    ]

    metric_stability_by_doc_type_df = compute_metric_stability_across_runs(
        per_run_metric_df=per_run_metric_df,
        metric_cols=metric_cols,
    )

    metric_stability_overall_df = compute_metric_stability_across_runs(
        per_run_metric_df=overall_per_run_metric_df,
        metric_cols=metric_cols,
    )

    # Field stability summaries
    doc_type_field_stability_summary_df = (
        build_doc_type_field_stability_summary(field_stability_df)
        if not field_stability_df.empty
        else pd.DataFrame()
    )

    overall_field_stability_summary_df = (
        build_overall_field_stability(field_stability_df)
        if not field_stability_df.empty
        else pd.DataFrame()
    )

    # Save outputs
    per_run_with_overall_df.to_csv(
        OUTPUT_DIR / "stability_per_run_metrics.csv",
        index=False,
    )

    metric_stability_by_doc_type_df.to_csv(
        OUTPUT_DIR / "stability_metric_level_by_doc_type.csv",
        index=False,
    )

    metric_stability_overall_df.to_csv(
        OUTPUT_DIR / "stability_metric_level_overall.csv",
        index=False,
    )

    field_stability_df.to_csv(
        OUTPUT_DIR / "stability_field_level_detail.csv",
        index=False,
    )

    doc_type_field_stability_summary_df.to_csv(
        OUTPUT_DIR / "stability_field_level_by_doc_type_summary.csv",
        index=False,
    )

    overall_field_stability_summary_df.to_csv(
        OUTPUT_DIR / "stability_field_level_overall_summary.csv",
        index=False,
    )

    print("\nSaved:")
    print(OUTPUT_DIR / "stability_per_run_metrics.csv")
    print(OUTPUT_DIR / "stability_metric_level_by_doc_type.csv")
    print(OUTPUT_DIR / "stability_metric_level_overall.csv")
    print(OUTPUT_DIR / "stability_field_level_detail.csv")
    print(OUTPUT_DIR / "stability_field_level_by_doc_type_summary.csv")
    print(OUTPUT_DIR / "stability_field_level_overall_summary.csv")


