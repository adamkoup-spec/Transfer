PERFORMANCE_OUTPUT_DIR = Path("./performance_metrics_thresholds_output")
DIAGNOSTIC_OUTPUT_DIR = PERFORMANCE_OUTPUT_DIR / "diagnostic_plots"
DIAGNOSTIC_OUTPUT_DIR.mkdir(parents=True, exist_ok=True)

# Use the same default threshold you care about most
DEFAULT_THRESHOLD_FOR_DIAGNOSTICS = 80

# These files should already be created by the final performance code
SUMMARY_PATH = PERFORMANCE_OUTPUT_DIR / "performance_summary_all_thresholds.csv"
ALL_FILES_PATH = PERFORMANCE_OUTPUT_DIR / "performance_all_files_all_thresholds.csv"
ALL_FIELDS_PATH = PERFORMANCE_OUTPUT_DIR / "performance_all_fields_all_thresholds.csv"


# =========================================================
# MANUAL OFFSETS
# =========================================================
# These are for diagnostic/error plots only.
#
# correct_offset:
#   manually verified false mismatches that should be treated as correct.
#
# error_offset:
#   direct adjustment to error count.
#   Usually this should be negative if manual review removes errors.
#
# Example:
# "A": {"correct_offset": 5, "error_offset": -5}
#
# If you only use correct_offset, the code automatically reduces errors by the same amount
# when applicable.
# =========================================================

MANUAL_DIAGNOSTIC_OFFSETS_BY_DOC_TYPE = {
    "A": {"correct_offset": 0, "error_offset": 0},
    "B": {"correct_offset": 0, "error_offset": 0},
    "C": {"correct_offset": 0, "error_offset": 0},

    # Example:
    # "business_address": {"correct_offset": 7, "error_offset": -7},
}

# Optional field-level offsets.
# Useful if you manually identify that a specific field had false mismatches.
#
# Key format:
#   (doc_type, field)
#
# Example:
#   ("A", "business_address.state"): {"correct_offset": 4, "error_offset": -4}
#
MANUAL_DIAGNOSTIC_OFFSETS_BY_FIELD = {
    # ("A", "address.state"): {"correct_offset": 3, "error_offset": -3},
}


# =========================================================
# HELPERS
# =========================================================

def load_performance_outputs():
    summary_df = pd.read_csv(SUMMARY_PATH)
    file_df = pd.read_csv(ALL_FILES_PATH)
    field_df = pd.read_csv(ALL_FIELDS_PATH)
    return summary_df, file_df, field_df


def safe_numeric(s):
    return pd.to_numeric(s, errors="coerce")


def get_doc_type_offsets(doc_type: str) -> Dict[str, int]:
    return MANUAL_DIAGNOSTIC_OFFSETS_BY_DOC_TYPE.get(
        doc_type,
        {"correct_offset": 0, "error_offset": 0},
    )


def get_field_offsets(doc_type: str, field: str) -> Dict[str, int]:
    return MANUAL_DIAGNOSTIC_OFFSETS_BY_FIELD.get(
        (doc_type, field),
        {"correct_offset": 0, "error_offset": 0},
    )


def apply_error_offsets_to_doc_summary(df: pd.DataFrame) -> pd.DataFrame:
    """
    Adds adjusted error columns for diagnostic plots.

    Expected columns:
      doc_type, total, covered, correct_raw/correct/correct_manual_offset,
      missing_pred, explicit_low_conf

    Error decomposition:
      correct
      incorrect_covered = covered - correct
      explicit_low_conf
      missing_pred

    Manual correct offsets reduce incorrect covered errors.
    """
    out = df.copy()

    out["total"] = safe_numeric(out["total"]).fillna(0)
    out["covered"] = safe_numeric(out["covered"]).fillna(0)

    if "correct" in out.columns:
        out["correct_base"] = safe_numeric(out["correct"]).fillna(0)
    elif "correct_raw" in out.columns:
        out["correct_base"] = safe_numeric(out["correct_raw"]).fillna(0)
    else:
        out["correct_base"] = 0

    out["missing_pred"] = safe_numeric(out.get("missing_pred", 0)).fillna(0)
    out["explicit_low_conf"] = safe_numeric(out.get("explicit_low_conf", 0)).fillna(0)

    adjusted_correct = []
    adjusted_incorrect_covered = []
    adjusted_total_errors = []

    for _, row in out.iterrows():
        doc_type = row["doc_type"]
        offsets = get_doc_type_offsets(doc_type)

        correct_offset = int(offsets.get("correct_offset", 0))
        error_offset = int(offsets.get("error_offset", 0))

        covered = int(row["covered"])
        correct_base = int(row["correct_base"])

        correct_adj = min(correct_base + correct_offset, covered)

        incorrect_covered = max(covered - correct_adj, 0)

        # error_offset is additional direct adjustment.
        # Negative reduces errors; positive increases errors.
        incorrect_covered = max(incorrect_covered + error_offset, 0)

        total_errors = (
            incorrect_covered
            + int(row["missing_pred"])
            + int(row["explicit_low_conf"])
        )

        adjusted_correct.append(correct_adj)
        adjusted_incorrect_covered.append(incorrect_covered)
        adjusted_total_errors.append(total_errors)

    out["correct_adjusted_for_diagnostics"] = adjusted_correct
    out["incorrect_covered_adjusted"] = adjusted_incorrect_covered
    out["total_errors_adjusted"] = adjusted_total_errors

    return out


def add_bar_labels(ax, fmt="%.2f", fontsize=8):
    for container in ax.containers:
        ax.bar_label(container, fmt=fmt, fontsize=fontsize, padding=2)


