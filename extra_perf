# 1. ERROR COMPOSITION STACKED BAR
# =========================================================

def plot_error_composition(summary_df: pd.DataFrame, threshold: int = 80):
    """
    Stacked bar showing:
      - correct covered predictions
      - incorrect covered predictions
      - explicit low confidence
      - missing predictions

    This explains whether failures come from wrong values, low confidence, or missing fields.
    """
    df = summary_df.copy()
    df = df[
        (df["threshold"] == threshold)
        & (df["doc_type"] != "OVERALL")
    ].copy()

    if df.empty:
        print("No rows for error composition plot.")
        return

    df = apply_error_offsets_to_doc_summary(df)

    plot_df = df.set_index("doc_type")[
        [
            "correct_adjusted_for_diagnostics",
            "incorrect_covered_adjusted",
            "explicit_low_conf",
            "missing_pred",
        ]
    ]

    plot_df = plot_df.apply(pd.to_numeric, errors="coerce").fillna(0)

    ax = plot_df.plot(
        kind="bar",
        stacked=True,
        figsize=(12, 6),
    )

    ax.set_title(f"Error Composition by Document Type at Threshold {threshold}")
    ax.set_xlabel("Document Type")
    ax.set_ylabel("Leaf Node Count")
    ax.legend(
        [
            "Correct Covered",
            "Incorrect Covered",
            "Explicit Low Confidence",
            "Missing Prediction",
        ],
        bbox_to_anchor=(1.02, 1),
        loc="upper left",
    )

    plt.tight_layout()
    out = DIAGNOSTIC_OUTPUT_DIR / f"error_composition_t{threshold}.png"
    plt.savefig(out, dpi=150)
    plt.close()
    print(f"Saved {out}")


def plot_error_composition_percent(summary_df: pd.DataFrame, threshold: int = 80):
    """
    Same as error composition, but normalized to 100%.
    """
    df = summary_df.copy()
    df = (
        df[
            (df["threshold"] == threshold)
            & (df["doc_type"] != "OVERALL")
        ]
        .copy()
    )

    if df.empty:
        print("No rows for percent error composition plot.")
        return

    df = apply_error_offsets_to_doc_summary(df)

    plot_df = df.set_index("doc_type")[
        [
            "correct_adjusted_for_diagnostics",
            "incorrect_covered_adjusted",
            "explicit_low_conf",
            "missing_pred",
        ]
    ]

    plot_df = plot_df.apply(pd.to_numeric, errors="coerce").fillna(0)

    row_sums = plot_df.sum(axis=1).replace(0, np.nan)
    plot_df_pct = plot_df.div(row_sums, axis=0)

    ax = plot_df_pct.plot(
        kind="bar",
        stacked=True,
        figsize=(12, 6),
    )

    ax.set_title(f"Error Composition Share by Document Type at Threshold {threshold}")
    ax.set_xlabel("Document Type")
    ax.set_ylabel("Share")
    ax.set_ylim(0, 1)
    ax.legend(
        [
            "Correct Covered",
            "Incorrect Covered",
            "Explicit Low Confidence",
            "Missing Prediction",
        ],
        bbox_to_anchor=(1.02, 1),
        loc="upper left",
    )

    plt.tight_layout()
    out = DIAGNOSTIC_OUTPUT_DIR / f"error_composition_percent_t{threshold}.png"
    plt.savefig(out, dpi=150)
    plt.close()
    print(f"Saved {out}")


