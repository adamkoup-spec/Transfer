# 4. TOP ERROR-CONTRIBUTING FIELDS / PARETO
# =========================================================

def build_field_error_table(file_df: pd.DataFrame, threshold: int = 80) -> pd.DataFrame:
    """
    Builds field-level error counts from the wide per-file table.

    Error definition:
      - covered but not matched
      - explicit low confidence
      - missing prediction

    Manual offsets can reduce errors for specific fields.
    """
    long_df = extract_field_level_records_from_file_df(file_df, threshold=threshold)

    if long_df.empty:
        return pd.DataFrame()

    rows = []

    for (doc_type, field), g in long_df.groupby(["doc_type", "field"], dropna=False):
        total = len(g)

        covered = (g["covered"] == True).sum()
        correct = ((g["covered"] == True) & (g["match"] == True)).sum()

        incorrect_covered = ((g["covered"] == True) & (g["match"] != True)).sum()
        explicit_low_conf = (g["status"] == "explicit_low_conf").sum()
        missing_pred = (g["status"] == "missing_pred").sum()

        raw_errors = int(incorrect_covered + explicit_low_conf + missing_pred)

        offsets = get_field_offsets(doc_type, field)
        correct_offset = int(offsets.get("correct_offset", 0))
        error_offset = int(offsets.get("error_offset", 0))

        # Correct offset mainly reduces incorrect covered count.
        adjusted_incorrect_covered = max(int(incorrect_covered) - correct_offset, 0)

        adjusted_errors = (
            adjusted_incorrect_covered
            + int(explicit_low_conf)
            + int(missing_pred)
            + error_offset
        )
        adjusted_errors = max(adjusted_errors, 0)

        coverage = covered / total if total else None
        accuracy = correct / covered if covered else None

        rows.append({
            "doc_type": doc_type,
            "field": field,
            "total": total,
            "covered": int(covered),
            "correct": int(correct),
            "coverage": coverage,
            "accuracy": accuracy,

            "incorrect_covered_raw": int(incorrect_covered),
            "explicit_low_conf": int(explicit_low_conf),
            "missing_pred": int(missing_pred),
            "raw_errors": raw_errors,

            "manual_correct_offset": correct_offset,
            "manual_error_offset": error_offset,
            "adjusted_errors": adjusted_errors,
        })

    out = pd.DataFrame(rows)

    if not out.empty:
        out = out.sort_values("adjusted_errors", ascending=False).reset_index(drop=True)
        total_errors = out["adjusted_errors"].sum()
        out["error_share"] = out["adjusted_errors"] / total_errors if total_errors else 0
        out["cumulative_error_share"] = out["error_share"].cumsum()

    return out


def plot_top_error_fields(file_df: pd.DataFrame, threshold: int = 80, top_n: int = 25):
    field_errors = build_field_error_table(file_df, threshold=threshold)

    if field_errors.empty:
        print("No field error data.")
        return

    csv_out = DIAGNOSTIC_OUTPUT_DIR / f"field_error_table_t{threshold}.csv"
    field_errors.to_csv(csv_out, index=False)
    print(f"Saved {csv_out}")

    top = field_errors.head(top_n).copy()
    top["display"] = top["doc_type"] + " | " + top["field"].astype(str)

    if top["adjusted_errors"].sum() == 0:
        print("No adjusted field errors to plot.")
        return

    ax = top.sort_values("adjusted_errors").plot(
        x="display",
        y="adjusted_errors",
        kind="barh",
        figsize=(12, max(6, top_n * 0.28)),
        legend=False,
    )

    ax.set_title(f"Top {top_n} Error-Contributing Fields at Threshold {threshold}")
    ax.set_xlabel("Adjusted Error Count")
    ax.set_ylabel("Doc Type | Field")

    plt.tight_layout()
    out = DIAGNOSTIC_OUTPUT_DIR / f"top_error_fields_t{threshold}.png"
    plt.savefig(out, dpi=150)
    plt.close()
    print(f"Saved {out}")


def plot_pareto_error_fields(file_df: pd.DataFrame, threshold: int = 80, top_n: int = 30):
    field_errors = build_field_error_table(file_df, threshold=threshold)

    if field_errors.empty:
        print("No field error data for Pareto plot.")
        return

    field_errors = field_errors[field_errors["adjusted_errors"] > 0].copy()

    if field_errors.empty:
        print("No adjusted errors for Pareto plot.")
        return

    top = field_errors.head(top_n).copy()
    top["display"] = top["doc_type"] + " | " + top["field"].astype(str)

    fig, ax1 = plt.subplots(figsize=(14, 6))

    ax1.bar(top["display"], top["adjusted_errors"])
    ax1.set_xlabel("Field")
    ax1.set_ylabel("Adjusted Error Count")
    ax1.tick_params(axis="x", rotation=75)

    ax2 = ax1.twinx()
    ax2.plot(top["display"], top["cumulative_error_share"], marker="o")
    ax2.set_ylabel("Cumulative Error Share")
    ax2.set_ylim(0, 1.05)

    ax1.set_title(f"Pareto Chart of Field Errors at Threshold {threshold}")

    plt.tight_layout()
    out = DIAGNOSTIC_OUTPUT_DIR / f"pareto_field_errors_t{threshold}.png"
    plt.savefig(out, dpi=150)
    plt.close()
    print(f"Saved {out}")


# =========================================================
# MAIN RUNNER
# =========================================================

def run_performance_diagnostic_plots(threshold: int = DEFAULT_THRESHOLD_FOR_DIAGNOSTICS):
    summary_df, file_df, field_df = load_performance_outputs()

    plot_error_composition(summary_df, threshold=threshold)
    plot_error_composition_percent(summary_df, threshold=threshold)

    plot_confidence_bucket_accuracy(file_df, threshold=threshold)
    plot_confidence_bucket_accuracy_by_doc_type(file_df, threshold=threshold)

    plot_file_level_boxplots(file_df, threshold=threshold)
    plot_file_level_histograms(file_df, threshold=threshold)

    plot_top_error_fields(file_df, threshold=threshold, top_n=25)
    plot_pareto_error_fields(file_df, threshold=threshold, top_n=30)

    print("\nSaved diagnostic outputs to:")
    print(DIAGNOSTIC_OUTPUT_DIR.resolve())


if __name__ == "__main__":
    run_performance_diagnostic_plots(threshold=DEFAULT_THRESHOLD_FOR_DIAGNOSTICS)
