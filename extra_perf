def plot_file_level_boxplots(file_df: pd.DataFrame, threshold: int = 80):
    """
    Boxplots show whether aggregate performance is stable across files
    or driven by outliers.
    """
    df = file_df.copy()
    df = df[(df["threshold"] == threshold) & (df["status"] == "OK")].copy()

    if df.empty:
        print("No rows for file-level boxplots.")
        return

    for metric in ["coverage", "accuracy", "f1_balanced_score", "f2_coverage_weighted_score"]:
        df[metric] = pd.to_numeric(df[metric], errors="coerce")

        if df[metric].dropna().empty:
            print(f"Skipping file-level boxplot for {metric}: no numeric data.")
            continue

        grouped = [
            df.loc[df["doc_type"] == dt, metric].dropna().values
            for dt in sorted(df["doc_type"].unique())
        ]
        labels = sorted(df["doc_type"].unique())

        fig, ax = plt.subplots(figsize=(10, 5))
        ax.boxplot(grouped, labels=labels, showmeans=True)
        ax.set_title(f"File-Level Distribution of {metric.replace('_', ' ').title()} at Threshold {threshold}")
        ax.set_xlabel("Document Type")
        ax.set_ylabel(metric.replace("_", " ").title())
        ax.set_ylim(0, 1.05)

        plt.tight_layout()
        out = DIAGNOSTIC_OUTPUT_DIR / f"file_level_boxplot_{metric}_t{threshold}.png"
        plt.savefig(out, dpi=150)
        plt.close()
        print(f"Saved {out}")


def plot_file_level_histograms(file_df: pd.DataFrame, threshold: int = 80):
    """
    Histograms of file-level coverage and accuracy.
    """
    df = file_df.copy()
    df = df[(df["threshold"] == threshold) & (df["status"] == "OK")].copy()

    if df.empty:
        print("No rows for file-level histograms.")
        return

    for metric in ["coverage", "accuracy"]:
        df[metric] = pd.to_numeric(df[metric], errors="coerce")
        values = df[metric].dropna()

        if values.empty:
            print(f"Skipping histogram for {metric}: no numeric data.")
            continue

        fig, ax = plt.subplots(figsize=(9, 5))
        ax.hist(values, bins=10)
        ax.set_title(f"File-Level {metric.title()} Distribution at Threshold {threshold}")
        ax.set_xlabel(metric.title())
        ax.set_ylabel("File Count")
        ax.set_xlim(0, 1)

        plt.tight_layout()
        out = DIAGNOSTIC_OUTPUT_DIR / f"file_level_histogram_{metric}_t{threshold}.png"
        plt.savefig(out, dpi=150)
        plt.close()
        print(f"Saved {out}")


