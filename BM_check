def evaluate_all_models() -> pd.DataFrame:
    rows = []

    for threshold in CONFIDENCE_THRESHOLDS:
        print(f"\n=== Threshold: {threshold} ===")

        for model_name, model_root in MODEL_ROOTS.items():
            print(f"Model: {model_name}")

            for doc_type, route in ROUTES_BY_FOLDER.items():
                row = evaluate_model_doc_type(
                    model_name=model_name,
                    model_root=model_root,
                    gt_root=GROUND_TRUTH_ROOT,
                    doc_type=doc_type,
                    route=route,
                    threshold=threshold,
                )
                rows.append(row)

    return pd.DataFrame(rows)


def build_overall_metrics(by_doc_type_df: pd.DataFrame) -> pd.DataFrame:
    rows = []

    for (model_name, threshold), g in by_doc_type_df.groupby(["model", "threshold"], dropna=False):
        total = int(g["total"].sum())
        covered = int(g["covered"].sum())
        correct_raw = int(g["correct_raw"].sum())
        correct_manual_offset = int(g["correct_manual_offset"].sum())
        correct = int(g["correct"].sum())

        coverage = covered / total if total else None
        accuracy = correct / covered if covered else None

        rows.append({
            "model": model_name,
            "doc_type": "OVERALL",
            "threshold": threshold,
            "files_compared": int(g["files_compared"].sum()),

            "result_file_without_matching_gt_ignored": int(g["result_file_without_matching_gt_ignored"].sum()),
            "gt_file_without_matching_result_ignored": int(g["gt_file_without_matching_result_ignored"].sum()),
            "route_failures": int(g["route_failures"].sum()),
            "unreadable_files": int(g["unreadable_files"].sum()),

            "total": total,
            "covered": covered,
            "correct_raw": correct_raw,
            "correct_manual_offset": correct_manual_offset,
            "correct": correct,
            "coverage": coverage,
            "accuracy": accuracy,
            "f1_balanced_score": fbeta_score(accuracy, coverage, beta=1.0),
            "f2_coverage_weighted_score": fbeta_score(accuracy, coverage, beta=2.0),

            "missing_pred": int(g["missing_pred"].sum()),
            "explicit_low_conf": int(g["explicit_low_conf"].sum()),
            "covered_with_confidence": int(g["covered_with_confidence"].sum()),
            "covered_without_confidence": int(g["covered_without_confidence"].sum()),

            "null_gt_fields": int(g["null_gt_fields"].sum()),
            "null_pred_covered": int(g["null_pred_covered"].sum()),
            "null_pred_correct": int(g["null_pred_correct"].sum()),
            "prediction_only_fields": int(g["prediction_only_fields"].sum()),
        })

    return pd.DataFrame(rows)


def add_delta_vs_production(
    df: pd.DataFrame,
    production_name: str = PRODUCTION_NAME,
) -> pd.DataFrame:
    metrics = [
        "coverage",
        "accuracy",
        "f1_balanced_score",
        "f2_coverage_weighted_score",
    ]

    out = df.copy()

    base = (
        out[out["model"] == production_name]
        [["doc_type", "threshold"] + metrics]
        .rename(columns={m: f"{m}_production" for m in metrics})
    )

    out = out.merge(base, on=["doc_type", "threshold"], how="left")

    for m in metrics:
        out[f"{m}_delta_vs_production"] = out[m] - out[f"{m}_production"]
        out[f"{m}_relative_change_vs_production"] = (
            out[f"{m}_delta_vs_production"] / out[f"{m}_production"]
        )

    return out


def build_ranking_table(overall_df: pd.DataFrame) -> pd.DataFrame:
    out = overall_df.copy()

    rank_cols = [
        "f1_balanced_score",
        "f2_coverage_weighted_score",
        "accuracy",
        "coverage",
    ]

    for col in rank_cols:
        out[f"{col}_rank"] = (
            out.groupby("threshold")[col]
            .rank(ascending=False, method="min")
        )

    out = out.sort_values(
        ["threshold", "f1_balanced_score", "f2_coverage_weighted_score", "accuracy", "coverage"],
        ascending=[True, False, False, False, False],
        na_position="last",
    ).reset_index(drop=True)

    return out


