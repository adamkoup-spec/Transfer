def run_benchmark_analysis() -> None:
    by_doc_type_df = evaluate_all_models()

    by_doc_type_out = OUTPUT_DIR / "benchmark_metrics_by_doc_type_all_thresholds.csv"
    by_doc_type_df.to_csv(by_doc_type_out, index=False)
    print(f"Saved {by_doc_type_out}")

    overall_df = build_overall_metrics(by_doc_type_df)

    overall_out = OUTPUT_DIR / "benchmark_metrics_overall_all_thresholds.csv"
    overall_df.to_csv(overall_out, index=False)
    print(f"Saved {overall_out}")

    by_doc_type_delta_df = add_delta_vs_production(by_doc_type_df, production_name=PRODUCTION_NAME)

    by_doc_type_delta_out = OUTPUT_DIR / "benchmark_delta_vs_production_by_doc_type_all_thresholds.csv"
    by_doc_type_delta_df.to_csv(by_doc_type_delta_out, index=False)
    print(f"Saved {by_doc_type_delta_out}")

    overall_delta_df = add_delta_vs_production(overall_df, production_name=PRODUCTION_NAME)

    overall_delta_out = OUTPUT_DIR / "benchmark_delta_vs_production_overall_all_thresholds.csv"
    overall_delta_df.to_csv(overall_delta_out, index=False)
    print(f"Saved {overall_delta_out}")

    ranking_df = build_ranking_table(overall_df)

    ranking_out = OUTPUT_DIR / "benchmark_model_ranking_all_thresholds.csv"
