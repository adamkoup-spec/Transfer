# =========================================================
# BASIC HELPERS
# =========================================================

def load_json(path: Path) -> Any:
    with open(path, "r", encoding="utf-8") as f:
        return json.load(f)


def normalize_value(x: Any) -> Any:
    if isinstance(x, str):
        if STRIP_STRINGS:
            x = x.strip()
        if CASE_INSENSITIVE_STRINGS:
            x = x.lower()
    return x


def get_by_route(obj: Any, route: str) -> Any:
    cur = obj

    if route is None or route == "":
        return cur

    for part in route.split("."):
        if isinstance(cur, dict):
            if part not in cur:
                return None
            cur = cur[part]

        elif isinstance(cur, list):
            if not part.isdigit():
                return None
            idx = int(part)
            if idx < 0 or idx >= len(cur):
                return None
            cur = cur[idx]

        else:
            return None

    return cur


def list_relative_jsons(folder: Path) -> List[Path]:
    if not folder.exists():
        return []
    return sorted([p.relative_to(folder) for p in folder.rglob("*.json")])


def coerce_confidence(x: Any) -> Optional[float]:
    if x is None:
        return None

    try:
        val = float(x)
    except Exception:
        return None

    if math.isnan(val):
        return None

    if CONFIDENCE_IS_PROBABILITY:
        val *= 100.0

    return val


def find_all_confidences(obj: Any) -> List[float]:
    confidences = []

    if isinstance(obj, dict):
        for k, v in obj.items():
            if k == "confidence":
                c = coerce_confidence(v)
                if c is not None:
                    confidences.append(c)
            else:
                confidences.extend(find_all_confidences(v))

    elif isinstance(obj, list):
        for item in obj:
            confidences.extend(find_all_confidences(item))

    return confidences


def extract_node_confidence(obj: Any) -> Optional[float]:
    confidences = find_all_confidences(obj)
    if not confidences:
        return None
    return max(confidences)


def fbeta_score(
    accuracy: Optional[float],
    coverage: Optional[float],
    beta: float = 1.0,
) -> Optional[float]:
    if accuracy is None or coverage is None:
        return None

    if accuracy == 0 and coverage == 0:
        return 0.0

    beta2 = beta ** 2
    denom = beta2 * accuracy + coverage

    if denom == 0:
        return 0.0

    return (1 + beta2) * accuracy * coverage / denom


def get_manual_correct_offset(model_name: str, doc_type: str) -> int:
    return int(
        MANUAL_CORRECT_OFFSET_BY_MODEL_AND_FOLDER
        .get(model_name, {})
        .get(doc_type, 0)
    )


# =========================================================
# FLATTENING
# =========================================================

def flatten_prediction_value_paths(
    obj: Any,
    parent_key: str = "",
) -> Dict[str, Dict[str, Any]]:
    """
    Recursively finds every dict containing key 'value'.

    Prediction output:
    {
        "address.city": {
            "value": "Dallas",
            "confidence": 91.0,
            "has_confidence": True
        }
    }

    Null is a real prediction value if the prediction node exists.
    """
    items = {}

    if isinstance(obj, dict):
        if "value" in obj:
            clean_key = parent_key if parent_key else "value"
            raw_value = obj.get("value")
            confidence = extract_node_confidence(obj)

            items[clean_key] = {
                "value": normalize_value(raw_value),
                "confidence": confidence,
                "has_confidence": confidence is not None,
            }

        for k, v in obj.items():
            if k == "value":
                continue

            new_key = f"{parent_key}.{k}" if parent_key else k
            items.update(flatten_prediction_value_paths(v, new_key))

    elif isinstance(obj, list):
        for i, v in enumerate(obj):
            new_key = f"{parent_key}.{i}" if parent_key else str(i)
            items.update(flatten_prediction_value_paths(v, new_key))

    return items


def flatten_gt_value_paths(
    obj: Any,
    parent_key: str = "",
) -> Dict[str, Any]:
    """
    Recursively finds every dict containing key 'value' on GT side.
    """
    items = {}

    if isinstance(obj, dict):
        if "value" in obj:
            clean_key = parent_key if parent_key else "value"
            items[clean_key] = normalize_value(obj.get("value"))

        for k, v in obj.items():
            if k == "value":
                continue

            new_key = f"{parent_key}.{k}" if parent_key else k
            items.update(flatten_gt_value_paths(v, new_key))

    elif isinstance(obj, list):
        for i, v in enumerate(obj):
            new_key = f"{parent_key}.{i}" if parent_key else str(i)
            items.update(flatten_gt_value_paths(v, new_key))

    return items


# =========================================================
# STATUS / COVERAGE LOGIC
# =========================================================

def classify_prediction_status(
    pred_info: Optional[Dict[str, Any]],
    threshold: float,
) -> str:
    """
    Latest rule:

    missing_pred:
        prediction key/node does not exist
        => not covered

    explicit_low_conf:
        prediction exists, confidence exists, confidence < threshold
        => not covered

    covered_with_confidence:
        prediction exists, confidence exists, confidence >= threshold
        => covered

    covered_without_confidence:
        prediction exists, confidence missing/null
        => covered

    This applies whether prediction value is null or non-null.
    """
    if pred_info is None:
        return "missing_pred"

    confidence = pred_info.get("confidence")

    if confidence is not None and confidence < threshold:
        return "explicit_low_conf"

    if confidence is not None and confidence >= threshold:
        return "covered_with_confidence"

    return "covered_without_confidence"


def is_covered_status(status: str) -> bool:
    return status in {
        "covered_with_confidence",
        "covered_without_confidence",
    }


# =========================================================
# EVALUATE ONE FILE
# =========================================================

def evaluate_one_file(
    gt_flat: Dict[str, Any],
    pred_flat: Dict[str, Dict[str, Any]],
    threshold: float,
) -> Dict[str, Any]:
    """
    Leaf-level only.

    total:
        all leaf fields appearing in GT or prediction.

    covered:
        prediction exists and is not explicitly low-confidence.

    correct:
        covered prediction value equals GT value.
        Null is compared as a real value.
    """
    all_fields = sorted(set(gt_flat.keys()) | set(pred_flat.keys()))

    total = len(all_fields)
    covered = 0
    correct = 0

    missing_pred = 0
    explicit_low_conf = 0
    covered_with_confidence = 0
    covered_without_confidence = 0

    null_gt_fields = 0
    null_pred_covered = 0
    null_pred_correct = 0
    prediction_only_fields = 0

    for field in all_fields:
        gt_present = field in gt_flat
        pred_present = field in pred_flat

        gt_val = gt_flat.get(field)
        pred_info = pred_flat.get(field)
        pred_val = pred_info.get("value") if pred_info is not None else None

        if gt_present and gt_val is None:
            null_gt_fields += 1

        if pred_present and not gt_present:
            prediction_only_fields += 1

        status = classify_prediction_status(pred_info, threshold)

        if is_covered_status(status):
            covered += 1

            if pred_val == gt_val:
                correct += 1

            if pred_val is None:
                null_pred_covered += 1
                if pred_val == gt_val:
                    null_pred_correct += 1

            if status == "covered_with_confidence":
                covered_with_confidence += 1
            elif status == "covered_without_confidence":
                covered_without_confidence += 1

        else:
            if status == "missing_pred":
                missing_pred += 1
            elif status == "explicit_low_conf":
                explicit_low_conf += 1

    coverage = covered / total if total else None
    accuracy = correct / covered if covered else None

    return {
        "total": total,
        "covered": covered,
        "correct": correct,
        "coverage": coverage,
        "accuracy": accuracy,
        "f1_balanced_score": fbeta_score(accuracy, coverage, beta=1.0),
        "f2_coverage_weighted_score": fbeta_score(accuracy, coverage, beta=2.0),

        "missing_pred": missing_pred,
        "explicit_low_conf": explicit_low_conf,
        "covered_with_confidence": covered_with_confidence,
        "covered_without_confidence": covered_without_confidence,

        "null_gt_fields": null_gt_fields,
        "null_pred_covered": null_pred_covered,
        "null_pred_correct": null_pred_correct,
        "prediction_only_fields": prediction_only_fields,
    }


# =========================================================
# EVALUATE MODEL + DOC TYPE
# =========================================================

def evaluate_model_doc_type(
    model_name: str,
    model_root: Path,
    gt_root: Path,
    doc_type: str,
    route: str,
    threshold: float,
) -> Dict[str, Any]:
    result_folder = model_root / doc_type
    gt_folder = gt_root / doc_type

    result_files = set(list_relative_jsons(result_folder))
    gt_files = set(list_relative_jsons(gt_folder))

    # Start from model outputs only; ignore result files with no matching GT.
    common_files = sorted([p for p in result_files if p in gt_files])

    total = 0
    covered = 0
    correct_raw = 0

    missing_pred = 0
    explicit_low_conf = 0
    covered_with_confidence = 0
    covered_without_confidence = 0

    null_gt_fields = 0
    null_pred_covered = 0
    null_pred_correct = 0
    prediction_only_fields = 0

    files_compared = 0
    route_failures = 0
    unreadable_files = 0

    result_file_without_matching_gt_ignored = len(result_files - gt_files)
    gt_file_without_matching_result_ignored = len(gt_files - result_files)

    for rel_path in common_files:
        pred_path = result_folder / rel_path
        gt_path = gt_folder / rel_path

        try:
            pred_json = load_json(pred_path)
            gt_json = load_json(gt_path)
        except Exception:
            unreadable_files += 1
            continue

        pred_subtree = get_by_route(pred_json, route)
        gt_subtree = get_by_route(gt_json, route)

        if pred_subtree is None or gt_subtree is None:
            route_failures += 1
            continue

        pred_flat = flatten_prediction_value_paths(pred_subtree)
        gt_flat = flatten_gt_value_paths(gt_subtree)

        file_eval = evaluate_one_file(
            gt_flat=gt_flat,
            pred_flat=pred_flat,
            threshold=threshold,
        )

        files_compared += 1

        total += file_eval["total"]
        covered += file_eval["covered"]
        correct_raw += file_eval["correct"]

        missing_pred += file_eval["missing_pred"]
        explicit_low_conf += file_eval["explicit_low_conf"]
        covered_with_confidence += file_eval["covered_with_confidence"]
        covered_without_confidence += file_eval["covered_without_confidence"]

        null_gt_fields += file_eval["null_gt_fields"]
        null_pred_covered += file_eval["null_pred_covered"]
        null_pred_correct += file_eval["null_pred_correct"]
        prediction_only_fields += file_eval["prediction_only_fields"]

    manual_offset = get_manual_correct_offset(model_name, doc_type)
    correct = min(correct_raw + manual_offset, covered)

    coverage = covered / total if total else None
    accuracy = correct / covered if covered else None

    return {
        "model": model_name,
        "doc_type": doc_type,
        "threshold": threshold,
        "files_compared": files_compared,

        "result_file_without_matching_gt_ignored": result_file_without_matching_gt_ignored,
        "gt_file_without_matching_result_ignored": gt_file_without_matching_result_ignored,
        "route_failures": route_failures,
        "unreadable_files": unreadable_files,

        "total": total,
        "covered": covered,
        "correct_raw": correct_raw,
        "correct_manual_offset": manual_offset,
        "correct": correct,
        "coverage": coverage,
        "accuracy": accuracy,
        "f1_balanced_score": fbeta_score(accuracy, coverage, beta=1.0),
        "f2_coverage_weighted_score": fbeta_score(accuracy, coverage, beta=2.0),

        "missing_pred": missing_pred,
        "explicit_low_conf": explicit_low_conf,
        "covered_with_confidence": covered_with_confidence,
        "covered_without_confidence": covered_without_confidence,

        "null_gt_fields": null_gt_fields,
        "null_pred_covered": null_pred_covered,
        "null_pred_correct": null_pred_correct,
        "prediction_only_fields": prediction_only_fields,
    }


