def get_model_order_present(df: pd.DataFrame) -> List[str]:
    present = set(df["model"])
    return [m for m in MODEL_ORDER if m in present]


def plot_metric_by_doc_type(
    df: pd.DataFrame,
    metric: str,
    threshold: float,
    title: str,
    output_path: Path,
) -> None:
    plot_source = df[df["threshold"] == threshold].copy()
    plot_source[metric] = pd.to_numeric(plot_source[metric], errors="coerce")

    if plot_source[metric].dropna().empty:
        print(f"SKIP plot: {metric} at threshold {threshold} has no numeric data.")
        return

    pivot = plot_source.pivot(index="doc_type", columns="model", values=metric)

    cols = [m for m in MODEL_ORDER if m in pivot.columns]
    pivot = pivot[cols]

    if pivot.dropna(how="all").empty:
        print(f"SKIP plot: {metric} at threshold {threshold} pivot is empty.")
        return

    ax = pivot.plot(kind="bar", figsize=(13, 6))
    ax.set_title(title)
    ax.set_xlabel("Doc Type")
    ax.set_ylabel(metric.replace("_", " ").title())
    ax.set_ylim(0, 1)
    ax.legend(title="Model", bbox_to_anchor=(1.02, 1), loc="upper left")
    plt.tight_layout()
    plt.savefig(output_path, dpi=150)
    plt.close()


def plot_overall_metric(
    overall_df: pd.DataFrame,
    metric: str,
    threshold: float,
    title: str,
    output_path: Path,
) -> None:
    plot_df = overall_df[overall_df["threshold"] == threshold].copy()
    plot_df[metric] = pd.to_numeric(plot_df[metric], errors="coerce")

    if plot_df[metric].dropna().empty:
        print(f"SKIP overall plot: {metric} at threshold {threshold} has no numeric data.")
        return

    plot_df = plot_df.set_index("model")
    order = [m for m in MODEL_ORDER if m in plot_df.index]
    plot_df = plot_df.loc[order]

    ax = plot_df[metric].plot(kind="bar", figsize=(11, 5))
    ax.set_title(title)
    ax.set_xlabel("Model")
    ax.set_ylabel(metric.replace("_", " ").title())
    ax.set_ylim(0, 1)
    plt.tight_layout()
    plt.savefig(output_path, dpi=150)
    plt.close()


def plot_coverage_accuracy_scatter(
    overall_df: pd.DataFrame,
    threshold: float,
    output_path: Path,
) -> None:
    plot_df = overall_df[overall_df["threshold"] == threshold].copy()

    fig, ax = plt.subplots(figsize=(8, 6))

    for _, row in plot_df.iterrows():
        x = row["coverage"]
        y = row["accuracy"]

        if pd.isna(x) or pd.isna(y):
            continue

        ax.scatter(x, y)
        ax.annotate(row["model"], (x, y), xytext=(5, 5), textcoords="offset points")

    ax.set_title(f"Overall Accuracy vs Coverage at Threshold {threshold}")
    ax.set_xlabel("Coverage")
    ax.set_ylabel("Accuracy")
    ax.set_xlim(0, 1)
    ax.set_ylim(0, 1)

    plt.tight_layout()
    plt.savefig(output_path, dpi=150)
    plt.close()


def plot_threshold_curve(
    overall_df: pd.DataFrame,
    metric: str,
    output_path: Path,
) -> None:
    pivot = overall_df.pivot(index="threshold", columns="model", values=metric)

    cols = [m for m in MODEL_ORDER if m in pivot.columns]
    pivot = pivot[cols]

    if pivot.dropna(how="all").empty:
        print(f"SKIP threshold curve: {metric} has no numeric data.")
