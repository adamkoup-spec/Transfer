def run_stress_test_analysis() -> None:
    by_doc_type_df = evaluate_all_stress_results()

    by_doc_type_out = OUTPUT_DIR / "stress_metrics_by_doc_type.csv"
    by_doc_type_df.to_csv(by_doc_type_out, index=False)
    print(f"Saved {by_doc_type_out}")

    overall_df = build_overall_metrics(by_doc_type_df)

    overall_out = OUTPUT_DIR / "stress_metrics_overall.csv"
    overall_df.to_csv(overall_out, index=False)
    print(f"Saved {overall_out}")

    by_doc_type_delta_df = add_delta_vs_baseline(
        by_doc_type_df,
        baseline_name=BASELINE_NAME,
    )

    by_doc_type_delta_out = OUTPUT_DIR / "stress_delta_vs_baseline_by_doc_type.csv"
    by_doc_type_delta_df.to_csv(by_doc_type_delta_out, index=False)
    print(f"Saved {by_doc_type_delta_out}")

    overall_delta_df = add_delta_vs_baseline(
        overall_df,
        baseline_name=BASELINE_NAME,
    )

    overall_delta_out = OUTPUT_DIR / "stress_delta_vs_baseline_overall.csv"
    overall_delta_df.to_csv(overall_delta_out, index=False)
    print(f"Saved {overall_delta_out}")

    generate_plots(
        by_doc_type_df=by_doc_type_df,
        by_doc_type_delta_df=by_doc_type_delta_df,
        overall_df=overall_df,
        overall_delta_df=overall_delta_df,
    )

    print("\nSaved CSV outputs to:")
    print(OUTPUT_DIR.resolve())

    print("\nSaved plots to:")
    print(PLOT_DIR.resolve())


if __name__ == "__main__":
    run_stress_test_analysis()
