def result_order_present(df: pd.DataFrame) -> List[str]:
    present = set(df["result_name"])
    return [x for x in RESULT_ORDER if x in present]


def plot_metric_by_doc_type(
    df: pd.DataFrame,
    metric: str,
    title: str,
    output_path: Path,
) -> None:
    plot_df = df.copy()
    plot_df[metric] = pd.to_numeric(plot_df[metric], errors="coerce")

    if plot_df[metric].dropna().empty:
        print(f"SKIP plot: {metric} has no numeric data.")
        return

    pivot = plot_df.pivot(index="doc_type", columns="result_name", values=metric)
    cols = [x for x in RESULT_ORDER if x in pivot.columns]
    pivot = pivot[cols]

    if pivot.dropna(how="all").empty:
        print(f"SKIP plot: {metric} pivot is empty.")
        return

    ax = pivot.plot(kind="bar", figsize=(12, 6))
    ax.set_title(title)
    ax.set_xlabel("Doc Type")
    ax.set_ylabel(metric.replace("_", " ").title())
    ax.set_ylim(0, 1)
    ax.legend(title="Stress Condition", bbox_to_anchor=(1.02, 1), loc="upper left")

    plt.tight_layout()
    plt.savefig(output_path, dpi=150)
    plt.close()


