from PIL import Image, ImageFilter, ImageEnhance
import numpy as np
from pathlib import Path
import io


def apply_distortion(img, level="light"):

    if level == "light":
        noise_std = 6
        blur_radius = 0.5
        rotation = 0.5
        contrast = 0.97
        sharpness = 0.9
        jpeg_quality = 85
        resize_scale = 0.97

    elif level == "medium":
        noise_std = 14
        blur_radius = 1.2
        rotation = 1.5
        contrast = 0.85
        sharpness = 0.7
        jpeg_quality = 55
        resize_scale = 0.85

    elif level == "heavy":
        noise_std = 28
        blur_radius = 2.2
        rotation = 3
        contrast = 0.7
        sharpness = 0.45
        jpeg_quality = 28
        resize_scale = 0.65

    else:
        raise ValueError("Choose light / medium / heavy")

    # Slight skew/rotation
    img = img.rotate(
        rotation,
        resample=Image.BICUBIC,
        expand=True,
        fillcolor="white"
    )

    # Downsample / upsample degradation
    w, h = img.size
    small = img.resize(
        (int(w * resize_scale), int(h * resize_scale)),
        Image.BILINEAR
    )

    img = small.resize((w, h), Image.BILINEAR)

    # Blur
    img = img.filter(ImageFilter.GaussianBlur(radius=blur_radius))

    # Contrast / sharpness degradation
    img = ImageEnhance.Contrast(img).enhance(contrast)
    img = ImageEnhance.Sharpness(img).enhance(sharpness)

    # JPEG compression artifacts
    buffer = io.BytesIO()
    img.save(buffer, format="JPEG", quality=jpeg_quality)
    buffer.seek(0)
    img = Image.open(buffer).convert("RGB")

    # Gaussian noise
    arr = np.array(img).astype(np.int16)

    noise = np.random.normal(
        0,
        noise_std,
        arr.shape
    ).astype(np.int16)

    arr = np.clip(arr + noise, 0, 255).astype(np.uint8)

    return Image.fromarray(arr)


def generate_noise_versions(input_png, output_dir=None):

    input_png = Path(input_png)

    if output_dir is None:
        output_dir = input_png.parent / "distorted"
    else:
        output_dir = Path(output_dir)

    output_dir.mkdir(parents=True, exist_ok=True)

    original = Image.open(input_png).convert("RGB")

    for level in ["light", "medium", "heavy"]:

        distorted = apply_distortion(
            original.copy(),
            level=level
        )

        output_path = output_dir / f"{input_png.stem}_{level}.png"

        distorted.save(output_path)

        print(f"Saved: {output_path}")


# Example
generate_noise_versions(
    input_png=r"H:\sample.png",
    output_dir=r"H:\distorted_outputs"
)
