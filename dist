from PIL import Image, ImageFilter, ImageEnhance
import numpy as np
import random
from pathlib import Path


def add_noise(img, noise_std=25):
    """Add random Gaussian noise."""
    arr = np.array(img).astype(np.int16)
    noise = np.random.normal(0, noise_std, arr.shape).astype(np.int16)
    noisy = np.clip(arr + noise, 0, 255).astype(np.uint8)
    return Image.fromarray(noisy)


def add_blur(img, radius=1.5):
    """Apply mild blur."""
    return img.filter(ImageFilter.GaussianBlur(radius=radius))


def add_skew_rotation(img, angle=2.5):
    """Apply slight rotation/skew-like distortion."""
    return img.rotate(
        angle,
        resample=Image.BICUBIC,
        expand=True,
        fillcolor="white"
    )


def add_low_quality_scan_effect(img):
    """Reduce contrast/sharpness to imitate low-quality scan."""
    img = ImageEnhance.Contrast(img).enhance(0.75)
    img = ImageEnhance.Sharpness(img).enhance(0.65)
    img = ImageEnhance.Brightness(img).enhance(0.95)
    return img


def distort_single_png(input_png_path, output_folder=None):
    input_png_path = Path(input_png_path)

    if output_folder is None:
        output_folder = input_png_path.parent
    else:
        output_folder = Path(output_folder)
        output_folder.mkdir(parents=True, exist_ok=True)

    img = Image.open(input_png_path).convert("RGB")

    # 1. Noise
    noisy_img = add_noise(img, noise_std=25)
    noisy_img.save(output_folder / f"{input_png_path.stem}_noise.png")

    # 2. Blur
    blurry_img = add_blur(img, radius=1.5)
    blurry_img.save(output_folder / f"{input_png_path.stem}_blur.png")

    # 3. Skew / rotation
    skewed_img = add_skew_rotation(img, angle=2.5)
    skewed_img.save(output_folder / f"{input_png_path.stem}_skew.png")

    print("Saved:")
    print(output_folder / f"{input_png_path.stem}_noise.png")
    print(output_folder / f"{input_png_path.stem}_blur.png")
    print(output_folder / f"{input_png_path.stem}_skew.png")


# Example usage
distort_single_png(
    input_png_path=r"H:\your_folder\sample.png",
    output_folder=r"H:\your_folder\distorted_outputs"
)
