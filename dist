from PIL import Image, ImageFilter, ImageEnhance
import numpy as np
from pathlib import Path
import io


DISTORTION_LEVELS = {
    "light": {
        "noise_std": 5,
        "blur_radius": 0.3,
        "rotation": 0.3,
        "contrast": 0.98,
        "sharpness": 0.95,
        "jpeg_quality": 92,
        "resize_scale": 0.98,
    },
    "medium": {
        "noise_std": 10,
        "blur_radius": 0.7,
        "rotation": 0.8,
        "contrast": 0.92,
        "sharpness": 0.85,
        "jpeg_quality": 80,
        "resize_scale": 0.93,
    },
    "heavy": {
        "noise_std": 16,
        "blur_radius": 1.0,
        "rotation": 1.2,
        "contrast": 0.85,
        "sharpness": 0.75,
        "jpeg_quality": 68,
        "resize_scale": 0.88,
    },
}


def apply_distortion(img, level="light"):
    if level not in DISTORTION_LEVELS:
        raise ValueError("level must be one of: light, medium, heavy")

    p = DISTORTION_LEVELS[level]

    img = img.convert("RGB")

    # Slight rotation
    img = img.rotate(
        p["rotation"],
        resample=Image.BICUBIC,
        expand=True,
        fillcolor="white"
    )

    # Mild resolution degradation
    w, h = img.size
    small = img.resize(
        (int(w * p["resize_scale"]), int(h * p["resize_scale"])),
        Image.BILINEAR
    )
    img = small.resize((w, h), Image.BILINEAR)

    # Blur
    img = img.filter(ImageFilter.GaussianBlur(radius=p["blur_radius"]))

    # Contrast and sharpness
    img = ImageEnhance.Contrast(img).enhance(p["contrast"])
    img = ImageEnhance.Sharpness(img).enhance(p["sharpness"])

    # JPEG compression artifact simulation
    buffer = io.BytesIO()
    img.save(buffer, format="JPEG", quality=p["jpeg_quality"])
    buffer.seek(0)
    img = Image.open(buffer).convert("RGB")

    # Gaussian noise
    arr = np.array(img).astype(np.int16)
    noise = np.random.normal(0, p["noise_std"], arr.shape).astype(np.int16)
    arr = np.clip(arr + noise, 0, 255).astype(np.uint8)

    return Image.fromarray(arr)


def generate_noise_versions(input_png, output_dir=None):
    input_png = Path(input_png)

    if output_dir is None:
        output_dir = input_png.parent / "distorted"
    else:
        output_dir = Path(output_dir)

    output_dir.mkdir(parents=True, exist_ok=True)

    original = Image.open(input_png).convert("RGB")

    for level in ["light", "medium", "heavy"]:
        distorted = apply_distortion(original.copy(), level=level)
        output_path = output_dir / f"{input_png.stem}_{level}.png"
        distorted.save(output_path)
        print(f"Saved: {output_path}")


# Example
generate_noise_versions(
    input_png=r"H:\sample.png",
    output_dir=r"H:\distorted_outputs"
)
