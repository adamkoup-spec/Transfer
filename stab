def save_top_unstable_fields_plot(field_df: pd.DataFrame, output_path: Path, top_n: int = 25) -> None:
    if field_df.empty:
        return

    df = field_df.copy()
    df["normalized_entropy"] = pd.to_numeric(df["normalized_entropy"], errors="coerce")
    df["retained_coverage"] = pd.to_numeric(df["retained_coverage"], errors="coerce")

    # Focus on fields that were retained in at least 2 runs;
    # otherwise entropy is not informative.
    df = df[df["n_retained_runs"] >= 2].copy()
    df = df.dropna(subset=["normalized_entropy"])

    if df.empty:
        print("Skipping top unstable fields plot: no eligible fields.")
        return

    df["display"] = df["doc_type"] + " | " + df["field"].astype(str)
    top = df.sort_values(["normalized_entropy", "retained_coverage"], ascending=[False, False]).head(top_n)

    ax = top.sort_values("normalized_entropy").plot(
        x="display",
        y="normalized_entropy",
        kind="barh",
        figsize=(12, max(6, top_n * 0.28)),
        legend=False,
    )
    ax.set_title(f"Top {top_n} Most Unstable Fields")
    ax.set_xlabel("Normalized Entropy")
    ax.set_ylabel("Doc Type | Field")
    ax.set_xlim(0, 1)
    plt.tight_layout()
    plt.savefig(output_path, dpi=150)
    plt.close()


def save_coverage_accuracy_scatter(per_run_with_overall_df: pd.DataFrame, output_path: Path) -> None:
    df = per_run_with_overall_df.copy()
    df["coverage"] = pd.to_numeric(df["coverage"], errors="coerce")
    df["accuracy"] = pd.to_numeric(df["accuracy"], errors="coerce")

    df = df.dropna(subset=["coverage", "accuracy"])

    if df.empty:
        print("Skipping coverage-accuracy scatter: no numeric data.")
        return

    fig, ax = plt.subplots(figsize=(9, 6))

    for _, row in df.iterrows():
        label = f"{row['run_name']} - {row['doc_type']}"
        ax.scatter(row["coverage"], row["accuracy"])
        ax.annotate(label, (row["coverage"], row["accuracy"]), xytext=(5, 5), textcoords="offset points", fontsize=8)

    ax.set_title("Coverage vs Accuracy Across Runs and Doc Types")
    ax.set_xlabel("Coverage")
    ax.set_ylabel("Accuracy")
    ax.set_xlim(0, 1)
    ax.set_ylim(0, 1)
    plt.tight_layout()
    plt.savefig(output_path, dpi=150)
