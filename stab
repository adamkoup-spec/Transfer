def ordered_run_names(df: pd.DataFrame) -> List[str]:
    present = set(df["run_name"])
    return [r for r in RUN_ORDER if r in present]


def save_bar_metric_by_run(per_run_df: pd.DataFrame, metric: str, output_path: Path) -> None:
    plot_df = per_run_df.copy()
    plot_df[metric] = pd.to_numeric(plot_df[metric], errors="coerce")

    pivot = plot_df.pivot(index="doc_type", columns="run_name", values=metric)
    cols = [r for r in RUN_ORDER if r in pivot.columns]
    pivot = pivot[cols]

    if pivot.dropna(how="all").empty:
        print(f"Skipping {metric} plot: no numeric data.")
        return

    ax = pivot.plot(kind="bar", figsize=(12, 6))
    ax.set_title(f"{metric.replace('_', ' ').title()} by Doc Type and Run")
    ax.set_xlabel("Doc Type")
    ax.set_ylabel(metric.replace("_", " ").title())
    ax.set_ylim(0, 1)
    ax.legend(title="Run", bbox_to_anchor=(1.02, 1), loc="upper left")
    plt.tight_layout()
    plt.savefig(output_path, dpi=150)
    plt.close()


def save_metric_range_plot(metric_stability_df: pd.DataFrame, metric: str, output_path: Path) -> None:
    df = metric_stability_df.copy()
    col = f"{metric}_range"
    df[col] = pd.to_numeric(df[col], errors="coerce")

    if df[col].dropna().empty:
        print(f"Skipping {metric} range plot: no numeric data.")
        return

    df = df.sort_values(col, ascending=False)

    ax = df.plot(x="doc_type", y=col, kind="bar", figsize=(10, 5), legend=False)
    ax.set_title(f"Run-to-Run Fluctuation: {metric.replace('_', ' ').title()} Range")
    ax.set_xlabel("Doc Type")
    ax.set_ylabel("Max - Min Across Runs")
    ax.set_ylim(0, max(0.05, df[col].max() * 1.15))
    plt.tight_layout()
    plt.savefig(output_path, dpi=150)
    plt.close()


def save_field_stability_summary_plot(field_summary_df: pd.DataFrame, output_path: Path) -> None:
    if field_summary_df.empty:
        return

    metrics = [
        "mean_retained_coverage",
        "mean_majority_agreement",
        "mean_normalized_entropy",
        "fully_stable_rate",
        "majority_correct_rate",
