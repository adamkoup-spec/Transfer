MANUAL_CORRECT_OFFSET_BY_RUN_AND_FOLDER = {
    "Run 1": {"A": 0, "B": 0, "C": 0},
    "Run 2": {"A": 0, "B": 0, "C": 0},
    "Run 3": {"A": 0, "B": 0, "C": 0},
