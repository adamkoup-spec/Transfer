RUN_ROOTS = {
    "Run 1": Path(r"C:\path\to\run_1"),
    "Run 2": Path(r"C:\path\to\run_2"),
    "Run 3": Path(r"C:\path\to\run_3"),
    "Run 4": Path(r"C:\path\to\run_4"),
    "Run 5": Path(r"C:\path\to\run_5"),
}

RUN_ORDER = ["Run 1", "Run 2", "Run 3", "Run 4", "Run 5"]

