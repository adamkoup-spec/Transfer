def save_stability_heatmap(field_summary_df: pd.DataFrame, output_path: Path) -> None:
    if field_summary_df.empty:
        return

    metric_cols = [
        "mean_retained_coverage",
        "mean_majority_agreement",
        "mean_normalized_entropy",
        "fully_stable_rate",
        "majority_correct_rate",
    ]

    df = field_summary_df.set_index("doc_type")[metric_cols].apply(pd.to_numeric, errors="coerce")

    if df.dropna(how="all").empty:
        print("Skipping heatmap: no numeric data.")
        return

    fig, ax = plt.subplots(figsize=(10, max(4, len(df) * 0.6)))

    im = ax.imshow(df.values, aspect="auto")

    ax.set_xticks(range(len(df.columns)))
    ax.set_xticklabels([c.replace("_", "\n") for c in df.columns], rotation=0, fontsize=8)
    ax.set_yticks(range(len(df.index)))
    ax.set_yticklabels(df.index)

    for i in range(df.shape[0]):
        for j in range(df.shape[1]):
            val = df.iloc[i, j]
            if pd.notna(val):
                ax.text(j, i, f"{val:.2f}", ha="center", va="center", fontsize=8)

    ax.set_title("Field Stability Heatmap by Doc Type")
    fig.colorbar(im, ax=ax, fraction=0.046, pad=0.04)
    plt.tight_layout()
    plt.savefig(output_path, dpi=150)
    plt.close()


def generate_plots(
    per_run_metric_df: pd.DataFrame,
    per_run_with_overall_df: pd.DataFrame,
    metric_stability_df: pd.DataFrame,
    field_df: pd.DataFrame,
    field_summary_df: pd.DataFrame,
) -> None:
    save_bar_metric_by_run(
        per_run_metric_df,
        metric="coverage",
        output_path=PLOT_DIR / "coverage_by_doc_type_and_run.png",
    )

    save_bar_metric_by_run(
        per_run_metric_df,
        metric="accuracy",
        output_path=PLOT_DIR / "accuracy_by_doc_type_and_run.png",
    )

    save_bar_metric_by_run(
        per_run_metric_df,
        metric="f1_balanced_score",
        output_path=PLOT_DIR / "balanced_score_by_doc_type_and_run.png",
    )

    save_metric_range_plot(
        metric_stability_df,
        metric="coverage",
        output_path=PLOT_DIR / "coverage_range_across_runs.png",
    )

    save_metric_range_plot(
        metric_stability_df,
        metric="accuracy",
        output_path=PLOT_DIR / "accuracy_range_across_runs.png",
    )

    save_metric_range_plot(
        metric_stability_df,
        metric="f1_balanced_score",
        output_path=PLOT_DIR / "balanced_score_range_across_runs.png",
    )

    save_field_stability_summary_plot(
        field_summary_df,
        output_path=PLOT_DIR / "field_stability_summary_by_doc_type.png",
    )

    save_top_unstable_fields_plot(
        field_df,
        output_path=PLOT_DIR / "top_unstable_fields.png",
        top_n=25,
    )

    save_coverage_accuracy_scatter(
        per_run_with_overall_df,
        output_path=PLOT_DIR / "coverage_vs_accuracy_scatter.png",
    )

    save_stability_heatmap(
        field_summary_df,
        output_path=PLOT_DIR / "field_stability_heatmap.png",
    )


