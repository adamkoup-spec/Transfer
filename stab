    ax = plot_df.plot(kind="bar", figsize=(13, 6))
    ax.set_title("Field-Level Stability Summary by Doc Type")
    ax.set_xlabel("Doc Type")
    ax.set_ylabel("Metric Value")
    ax.set_ylim(0, 1)
